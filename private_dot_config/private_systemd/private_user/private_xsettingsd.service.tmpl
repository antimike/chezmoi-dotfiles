{{- $exec := lookPath "xsettingsd" -}}
{{- if $exec -}}
{{- $tmpl := includeTemplate "systemd/xsettingsd.yaml" . | fromYaml -}}
{{- /* .filesystem.* paths may be home-relative; anchor them to the home
       dir so stat and realpath don't resolve them against chezmoi's cwd */ -}}
{{- $abs := dict -}}
{{- range $key := list "script" "config" "output" -}}
{{-   $p := get $tmpl $key -}}
{{-   if not (osIsAbs $p) }}{{ $p = joinPath $.chezmoi.homeDir $p }}{{ end -}}
{{-   $_ := set $abs $key $p -}}
{{- end -}}
{{- if and (stat $abs.script) (stat $abs.config) -}}
{{- $script := list .chezmoi.homeDir $abs.script | includeTemplate "cmd/relpath" | joinPath "%h" | trim -}}
{{- $output := list .chezmoi.homeDir $abs.output | includeTemplate "cmd/relpath" | joinPath "%h" | trim -}}
[Unit]
Description=XSETTINGS daemon
PartOf=graphical-session.target

[Service]
Environment="XSETTINGSD_OUTPUT={{ $output }}"
Restart=on-failure
ExecStartPre={{ $script }}
ExecStart={{ $exec }} -c {{ $output }}
ExecReload={{ $script }}
ExecReload={{ lookPath "kill" }} -HUP $MAINPID
# Restart i3 (it uses Xft.dpi)
ExecReload=-{{ lookPath "i3-msg" }} restart
# Restart polybar (it uses an environment variable)
ExecReload={{ lookPath "systemctl" }} --user try-restart polybar.service
{{- end -}}
{{- end -}}
