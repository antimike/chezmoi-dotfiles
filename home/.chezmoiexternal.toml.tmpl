{{range $name, $data := .externals}}
{{- if hasKey $data "dest" -}}
{{
  pick 
    $data 
      "type"
      "encrypted"
      "exact"
      "exclude"
      "executable"
      "format"
      "path"
      "include"
      "refreshPeriod"
      "stripComponents"
      "url"
      "checksum"
      "clone"
      "filter"
      "pull"
      "archive"
  | dict (get $data "dest") | toToml
}}
{{- end }}
{{end}}
