#!/bin/sh
# run_onchange_install-uwsm.sh.tmpl — build uwsm (github.com/Vladimir-csp/uwsm)
# and install it, plus the uwsm GDM session entries, to /usr/local.
#
# Pin and session entries: .chezmoidata/uwsm.yaml. The installer clones the tag
# shallowly and refuses to build unless HEAD is exactly the pinned commit, then
# builds with meson as the user into a staging tree under
# ~/.local/state/chezmoi-system/uwsm/<version>/. Only the copy into /usr/local
# needs root: a generated install-as-root.sh next to the staging tree.
# files.txt lists every installed path, and uninstall.sh removes them; both
# stay after the install, while the staging tree is deleted. Without cached
# credentials, sudo asks for the password when `chezmoi apply` runs in a
# terminal; otherwise the script prints the command and exits 1, so the next
# `chezmoi apply` retries.
#
# The nvidia check is made at render time: after installing or removing the
# proprietary driver, re-run `chezmoi apply` so the entries are rewritten.
#
# Only runs on Linux, non-WSL hosts whose `display_server` host key is "wayland".
# Snapshot /etc before system changes (docs/runbooks/display-session-recovery.md);
# this touches /usr/local only, which etckeeper does not track.
{{- $ds := dig "display_server" "x11" . -}}
{{- $run := and (eq .chezmoi.os "linux") (eq $ds "wayland") (ne (includeTemplate "is-wsl" .) "true") }}
{{- /* Proprietary nvidia driver loaded at render time: sessions' nvidiaArgs apply. */}}
{{- $nvidia := not (not (stat "/sys/module/nvidia")) }}
set -eu

ENABLED={{ if $run }}1{{ else }}0{{ end }}
VERSION={{ .uwsm.version | quote }}
EXPECTED_COMMIT={{ .uwsm.commit | quote }}
REPO_URL={{ .uwsm.repo | quote }}
PREFIX=/usr/local
STATE_DIR={{ joinPath .chezmoi.homeDir ".local" "state" "chezmoi-system" "uwsm" | quote }}/$VERSION
STAGE=$STATE_DIR/root

if [ "$ENABLED" != 1 ]; then
  echo "uwsm installer: needs non-WSL Linux with display_server=wayland (this host: {{ .chezmoi.os }}, {{ $ds }}); skipping" >&2
  exit 0
fi
for tool in git meson python3 scdoc; do
  if ! command -v "$tool" >/dev/null 2>&1; then
    echo "uwsm installer: '$tool' not found; install it (packages.yaml, the wayland target) and re-run; skipping" >&2
    exit 0
  fi
done

# Session entries, rendered from uwsm.yaml: "<id>.desktop" then its content.
write_sessions() {
  dir=$1/share/wayland-sessions
  mkdir -p "$dir"
{{- range .uwsm.sessions }}
  cat > "$dir/{{ .id }}.desktop" <<'EOF'
[Desktop Entry]
Name={{ .name }}
Comment={{ .comment }}
Exec={{ .exec }}{{ if and $nvidia (hasKey . "nvidiaArgs") }} {{ .nvidiaArgs }}{{ end }}
TryExec=uwsm
DesktopNames={{ .desktopNames }}
Type=Application
EOF
{{- end }}
}

# Idempotency guard: the pinned version is installed and every session entry
# matches what this script would write.
check_dir=$(mktemp -d)
trap 'rm -rf "$check_dir"' EXIT
write_sessions "$check_dir"
up_to_date=0
if [ "$("$PREFIX/bin/uwsm" --version 2>/dev/null)" = "uwsm ${VERSION#v}" ]; then
  up_to_date=1
  for f in "$check_dir"/share/wayland-sessions/*.desktop; do
    cmp -s "$f" "$PREFIX/share/wayland-sessions/${f##*/}" || up_to_date=0
  done
fi
if [ "$up_to_date" = 1 ]; then
  # Staging tree left by a root step run by hand: no longer needed.
  rm -rf "$STAGE"
  echo "uwsm installer: $VERSION and session entries already installed in $PREFIX" >&2
  exit 0
fi

# Build and stage (as the user).
tmp_dir=$(mktemp -d)
trap 'rm -rf "$check_dir" "$tmp_dir"' EXIT
echo "uwsm installer: cloning $REPO_URL at $VERSION" >&2
git -c advice.detachedHead=false clone -q --depth 1 --branch "$VERSION" "$REPO_URL" "$tmp_dir/src"
actual=$(git -C "$tmp_dir/src" rev-parse HEAD)
if [ "$EXPECTED_COMMIT" != "$actual" ]; then
  echo "uwsm installer: commit mismatch for $VERSION" >&2
  echo "  expected: $EXPECTED_COMMIT" >&2
  echo "  actual:   $actual" >&2
  exit 1
fi

echo "uwsm installer: building with meson" >&2
meson setup "$tmp_dir/build" "$tmp_dir/src" --prefix="$PREFIX" \
{{- range .uwsm.mesonOptions }}
  -D{{ . | quote }} \
{{- end }}
  >"$tmp_dir/setup.log" 2>&1 || { cat "$tmp_dir/setup.log" >&2; exit 1; }
meson compile -C "$tmp_dir/build" >"$tmp_dir/compile.log" 2>&1 || { cat "$tmp_dir/compile.log" >&2; exit 1; }

rm -rf "$STATE_DIR"
mkdir -p "$STATE_DIR"
DESTDIR="$STAGE" meson install -C "$tmp_dir/build" --quiet >/dev/null
write_sessions "$STAGE$PREFIX"

# Regular files, plus symlinks to a sibling (upstream aliases such as
# uwsm-terminal -> uwsm-app); anything else is refused.
if [ -n "$(find "$STAGE" ! -type f ! -type d ! -type l)" ] \
    || [ -n "$(find "$STAGE" -type l -lname '*/*')" ]; then
  echo "uwsm installer: staging tree has unexpected entries (special files or non-sibling links); refusing" >&2
  exit 1
fi
(cd "$STAGE" && find . -type f | sed 's#^\.##' | sort) > "$STATE_DIR/regular.txt"
(cd "$STAGE" && find . -type l -printf '%P\t%l\n' | sed 's#^#/#' | sort) > "$STATE_DIR/links.txt"
{ cat "$STATE_DIR/regular.txt"; cut -f1 "$STATE_DIR/links.txt"; } > "$STATE_DIR/files.txt"

cat > "$STATE_DIR/install-as-root.sh" <<EOF
#!/bin/sh
# Generated by run_onchange_install-uwsm.sh.tmpl: copy the uwsm $VERSION staging
# tree into /, root-owned, keeping file modes; restore SELinux labels.
set -eu
while IFS= read -r f; do
  install -D -m "\$(stat -c %a "$STAGE\$f")" "$STAGE\$f" "\$f"
done < "$STATE_DIR/regular.txt"
while IFS="\$(printf '\t')" read -r link target; do
  ln -sfn "\$target" "\$link"
done < "$STATE_DIR/links.txt"
if command -v restorecon >/dev/null 2>&1; then
  xargs -d '\n' restorecon -F < "$STATE_DIR/files.txt"
fi
echo "uwsm $VERSION installed; uninstall with: sudo sh $STATE_DIR/uninstall.sh"
EOF
cat > "$STATE_DIR/uninstall.sh" <<EOF
#!/bin/sh
# Generated by run_onchange_install-uwsm.sh.tmpl: remove the files uwsm $VERSION installed.
set -eu
xargs -d '\n' rm -f < "$STATE_DIR/files.txt"
EOF
echo "uwsm installer: staged $(wc -l < "$STATE_DIR/files.txt") files in $STAGE" >&2

# Install (root).
if [ "$(id -u)" -eq 0 ]; then
  sh "$STATE_DIR/install-as-root.sh"
elif sudo -n true 2>/dev/null || [ -t 0 ]; then
  echo "uwsm installer: installing to $PREFIX with sudo ($STATE_DIR/install-as-root.sh)" >&2
  sudo sh "$STATE_DIR/install-as-root.sh"
else
  echo "uwsm installer: need root. Read, then run:" >&2
  echo "  sudo sh $STATE_DIR/install-as-root.sh" >&2
  echo "  (the next chezmoi apply then removes the staging tree)" >&2
  exit 1
fi
rm -rf "$STAGE"
systemctl --user daemon-reload 2>/dev/null || true
echo "uwsm installer: $VERSION installed to $PREFIX" >&2
