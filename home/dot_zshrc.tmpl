{{- $zsh_tmpls := joinPath .chezmoi.sourceDir ".chezmoitemplates" "zsh" -}}
{{- $data := . -}}
#!usr/bin/env zsh

# GnuPG: pinentry needs the terminal. $TTY (not $(tty)) also works below the
# instant prompt, which redirects stdin. On a text console (Ctrl+Alt+F3), point
# the agent's startup tty and display at it too, so SSH/YubiKey prompts use
# pinentry-curses here instead of a GUI pinentry on the hidden graphical
# session. Back in the GUI, run `sshstart` once to move them back (GUI shells
# do not do it on their own).
export GPG_TTY=$TTY
if [[ -o login && $TTY == /dev/tty[0-9]* && -z $WAYLAND_DISPLAY && -z $DISPLAY ]] \
    && (( $+commands[gpg-connect-agent] )); then
  export PINENTRY_USER_DATA=curses   # read by ~/.local/bin/pinentry-auto
  gpg-connect-agent updatestartuptty /bye >/dev/null 2>&1
fi

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

export ZINIT_HOME={{ joinPath "$HOME" .filesystem.appData "zinit" "zinit.git" | quote }}
export ZCOMP_CACHE={{ joinPath "$HOME" .filesystem.cacheDir "zcomp" | quote }}
[[ -d "$ZCOMP_CACHE" ]] || mkdir -p "$ZCOMP_CACHE"
# zinit's zicompinit (run by a turbo plugin's atinit, with -C) must load the dump our compinit
# below keeps fresh; its default, ~/.zcompdump, is never refreshed and would undo new completions.
typeset -gA ZINIT
ZINIT[ZCOMPDUMP_PATH]="${ZCOMP_CACHE}/.zcompdump"

source "${ZINIT_HOME}/zinit.zsh"

# - - - - - - - - - - - - - - - - - - - -
# Profiling Tools
# To turn on profiling, run 'touch ~/.zsh-profile-startup' and restart the shell
# To turn off profiling, run 'rm ~/.zsh-profile-startup' and restart the shell
# - - - - - - - - - - - - - - - - - - - -
PROFILE_STARTUP=false
if [[ -e "${HOME}/.zsh-profile-startup" ]]; then
  PROFILE_STARTUP=true
  zmodload zsh/zprof
  # http://zsh.sourceforge.net/Doc/Release/Prompt-Expansion.html
  PS4=$'%D{%M%S%.} %N:%i> '
  exec 3>&2 2>${HOME}/.cache/logs/zinit.$$.log
  setopt xtrace prompt_subst
fi

# - - - - - - - - - - - - - - - - - - - -
# Zsh Core Configuration
# - - - - - - - - - - - - - - - - - - - -

# Load The Prompt System And Completion System And Initilize Them.
autoload -Uz compinit promptinit

# Completions managed here (static files, and the ones the installers generate)
# live in one directory. Put it on fpath before compinit so they need no
# per-tool linking step.
_comp_dir={{ joinPath "$HOME" .filesystem.appData "zsh" "completions" | quote }}
fpath=("$_comp_dir" $fpath)

# Load And Initialize The Completion System Ignoring Insecure Directories. The dump
# is regenerated when it is more than 20 days old (the (Nm-20) glob qualifier; the glob
# must stay unquoted or it never expands and the dump is never refreshed), or when a
# file in the completions directory is newer than it (compinit -C never looks for new
# files, so a freshly generated completion would stay unregistered until then).
# See: https://gist.github.com/ctechols/ca1035271ad134841284
_comp_dump="${ZCOMP_CACHE}/.zcompdump"
_comp_files=(${_comp_dump}(Nm-20))
_comp_newer=(${_comp_dir}/_*(Ne:'[[ $REPLY -nt $_comp_dump ]]':))
if (( $#_comp_files && ! $#_comp_newer )); then
    compinit -i -C -d "$_comp_dump"
else
    compinit -i -d "$_comp_dump"
fi
unset _comp_files _comp_newer _comp_dump _comp_dir
promptinit
setopt prompt_subst

autoload -U colors && colors    # Load Colors.

{{- if (hasKey .zsh "theme") }}
# - - - - - - - - - - - - - - - - - - - -
# Theme
# - - - - - - - - - - - - - - - - - - - -
{{ includeTemplate (joinPath "zsh/themes" .zsh.theme) }}
{{ end }}

{{ if .zsh.use_old_annexes }}
# - - - - - - - - - - - - - - - - - - - -
# Annexes
# - - - - - - - - - - - - - - - - - - - -

# These provide the following functionality:
#       * bin-gem-node: can create and manage executable shims
#       * submods: allows zinit to clone into submodules
#       * declare-zsh: allows CLI parsing and modification of .zshrc
zinit light-mode for \
    zdharma-continuum/declare-zsh
    zinit-zsh/zinit-annex-bin-gem-node \
    zinit-zsh/zinit-annex-submods \
{{ end }}

# - - - - - - - - - - - - - - - - - - - -
# ZSH Opts
# - - - - - - - - - - - - - - - - - - - -

{{ includeTemplate "zsh/opts.zsh" }}

# - - - - - - - - - - - - - - - - - - - -
# Completion settings (zstyle)
# - - - - - - - - - - - - - - - - - - - -

{{ includeTemplate "zsh/zstyle.zsh" $data }}

# - - - - - - - - - - - - - - - - - - - -
# Plugins
# - - - - - - - - - - - - - - - - - - - -

{{- $plugin_files := joinPath $zsh_tmpls "plugins.{yml,yaml}" | glob -}}
{{- $plugin_files = concat $plugin_files (joinPath $zsh_tmpls "plugins.d" "**" "*.{yaml,yml}" | glob | sortAlpha) -}}
{{- range $file := $plugin_files -}}
  {{- $contents := includeTemplate $file $data | fromYaml -}}
  {{- if eq (kindOf $contents) "map" -}}
    {{- $plugins := includeTemplate $file $data | fromYaml | jq ".plugins[]" -}}
    {{- range $plugins -}}
      {{- includeTemplate "zsh/plugin" . -}}
    {{- end -}}
  {{- end -}}
{{- end -}}

# - - - - - - - - - - - - - - - - - - - -
# User Configuration
# - - - - - - - - - - - - - - - - - - - -

# Debian and Ubuntu install bat as batcat.
if (( $+commands[batcat] && ! $+commands[bat] )); then
  alias bat=batcat
fi

alias purescript=purs

zinit add-fpath {{ joinPath "$HOME" .filesystem.appData "zsh" "functions" | quote }}

zinit wait lucid \
  id-as"local-snippets" nocompile \
  multisrc{{ joinPath "$HOME" .filesystem.appData "zsh" "snippets" "*.zsh" | quote }} \
  atinit"autoload -Uz {{ joinPath "$HOME" .filesystem.appData "zsh" "functions" "*(:t)" }}" \
for zdharma-continuum/null

zinit snippet {{ joinPath "$HOME" .filesystem.appData "zsh" "local.plugin.zsh" | quote }}

# - - - - - - - - - - - - - - - - - - - -
# End Profiling Script
# - - - - - - - - - - - - - - - - - - - -

if [[ "$PROFILE_STARTUP" == true ]]; then
    unsetopt xtrace
    exec 2>&3 3>&-
    zprof > ~/zshprofile$(date +'%s')
fi

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
