#!/usr/bin/env bash
# waybar-module — JSON for waybar's custom modules (~/.config/waybar/modules.jsonc).
#
#   waybar-module idle      shown while the idle chain is paused (idle-toggle); click resumes
#   waybar-module dunst     shown while notifications are paused, with the waiting count
#   waybar-module weather   current conditions from wttr.in (location by IP, no API key)
#   waybar-module recording a red dot and the elapsed time while screen-record runs; click stops it
#   waybar-module sunset    hyprsunset's colour temperature; re-applies a held value (sunset hold)
#
# Empty text hides a module, so idle and dunst show only the unusual state, and weather
# hides when offline with no recent cache. Refreshed on an interval and by signal:
# `pkill -RTMIN+8 -x waybar` (idle), `-RTMIN+9` (dunst), `-RTMIN+10` (weather),
# `-RTMIN+11` (recording; screen-record sends it on start and stop), `-RTMIN+12` (sunset).
set -euo pipefail

out() { jq -cn --arg text "$1" --arg class "$2" --arg tooltip "$3" '{$text, $class, $tooltip}'; }

# wttr.in's current conditions as module JSON. Units follow LC_MEASUREMENT (US: °F).
# A failed fetch reuses the last answer for up to 3 hours, marked stale.
weather() {
  local cache=${XDG_CACHE_HOME:-$HOME/.cache}/waybar-weather.json f=C speed=Kmph unit=km/h
  [[ ${LC_MEASUREMENT:-${LANG:-}} == en_US* ]] && f=F speed=Miles unit=mph
  local class=""
  if curl -fsS -m 10 'https://wttr.in/?format=j1' -o "$cache.new" 2>/dev/null && jq -e .current_condition "$cache.new" >/dev/null; then
    mv "$cache.new" "$cache"
  else
    rm -f "$cache.new"
    if [[ ! -s $cache ]] || (($(date +%s) - $(stat -c %Y "$cache") > 10800)); then
      out '' '' ''
      return
    fi
    class=stale
  fi
  jq -c --arg f "$f" --arg speed "$speed" --arg unit "$unit" --arg class "$class" '
    .current_condition[0] as $c | ($c.weatherCode | tonumber) as $code |
    (if $code == 113 then "󰖙"
     elif $code == 116 then "󰖕"
     elif $code == 119 or $code == 122 then "󰖐"
     elif [143, 248, 260] | index($code) then "󰖑"
     elif [200, 386, 389, 392, 395] | index($code) then "󰖓"
     elif [179, 182, 185, 227, 230, 317, 320, 323, 326, 329, 332, 335, 338, 350, 362, 365, 368, 371, 374, 377] | index($code) then "󰖘"
     else "󰖗" end) as $icon |
    {text: "\($icon) \($c["temp_" + $f])°\($f)",
     class: $class,
     tooltip: "\($c.weatherDesc[0].value | sub(" +$"; "")), feels like \($c["FeelsLike" + $f])°\($f)\nwind \($c["windspeed" + $speed]) \($unit), humidity \($c.humidity)%\(if $class == "stale" then "\n(offline: last update \($c.localObsDateTime))" else "" end)\nclick: forecast; right click: refresh"}' "$cache"
}

# Colour temperature: held value (sunset up/down) or the active hyprsunset profile, and the
# next scheduled change. Hidden while hyprsunset is not running (SwayFX, or before it starts).
sunset_module() {
  local prof k ptime ptemp identity=false class="" next nt nv tip
  pgrep -u "$UID" -x hyprsunset >/dev/null && prof=$(hyprctl hyprsunset profile 2>/dev/null) && [[ $prof == *Time:* ]] || {
    out '' '' ''
    return
  }
  sunset hold
  sunset wake
  ptime=$(sed -n 's/^Time: //p' <<<"$prof")
  ptemp=$(sed -n 's/^Temperature: //p' <<<"$prof")
  [[ $prof == *"Identity: true"* ]] && identity=true
  if k=$(sunset held); then
    class=held
  elif [[ $identity == true ]]; then
    k=""
  else
    k=$(hyprctl hyprsunset temperature)
  fi
  local text
  if [[ -z $k ]]; then text=$'\U000f0599 off'
  elif ((k > 5000)); then text=$'\U000f05a8 '"$k K"
  elif ((k >= 4000)); then text=$'\U000f059a '"$k K"
  else text=$'\U000f0594 '"$k K"; fi
  local sched="off (identity)"
  [[ $identity == true ]] || sched="$ptemp K"
  if [[ $class == held ]]; then tip="Held at $k K until you click; the schedule says $sched since $ptime"
  else tip="Schedule: $sched since $ptime"; fi
  if next=$(sunset next); then
    read -r nt nv <<<"$next"
    [[ $nv == identity ]] && nv=off || nv="$nv K"
    tip+=$'\n'"Next: $nv at $nt"
    [[ $class == held ]] && tip+=" (the held value stays)"
  fi
  tip+=$'\n''scroll: ±250 K (held); click: back to the schedule'
  out "$text" "$class" "$tip"
}

case ${1:-} in
  idle)
    if systemctl --user --quiet is-active swayidle-locking.service; then
      out $'\U000f0176 idle paused' paused 'No dim, lock, screens off or suspend on timeout. Click to resume.'
    else
      out '' '' ''
    fi
    ;;
  dunst)
    if [[ $(dunstctl is-paused) == true ]]; then
      out $'\U000f009b '"$(dunstctl count waiting)" paused 'Notifications paused (count: waiting). Click to resume.'
    else
      out '' '' ''
    fi
    ;;
  weather)
    weather
    ;;
  recording)
    # Runs every second: no jq when idle, the usual case.
    if rec=$(screen-record status 2>/dev/null); then
      read -r _ start _ file <<<"$rec"
      s=$(($(date +%s) - start))
      if ((s >= 3600)); then t=$(printf '%d:%02d:%02d' $((s / 3600)) $((s % 3600 / 60)) $((s % 60)))
      else t=$(printf '%02d:%02d' $((s / 60)) $((s % 60))); fi
      out $'\U000f044a '"$t" recording "Recording to ${file/#"$HOME"/\~}"$'\n''Click to stop.'
    else
      echo '{"text":""}'
    fi
    ;;
  sunset)
    sunset_module
    ;;
  *)
    echo "usage: waybar-module idle|dunst|weather|recording|sunset" >&2
    exit 2
    ;;
esac
