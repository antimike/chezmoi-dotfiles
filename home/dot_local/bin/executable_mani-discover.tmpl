{{ if and (lookPath "mani") (lookPath "fd") -}}
#!/usr/bin/env bash
# mani-discover: (re)generate ~/mani.yaml, the registry of git clones on this
# machine (D35). Clone locations differ per machine, so the file is generated
# here and NOT managed by chezmoi; the tasks run on it live in the managed
# ~/.config/mani/config.yaml.
#
# Finds every directory with a .git directory (not worktrees or submodules,
# whose .git is a file) under the root folders below, plus the fixed paths.
# Project names: a clone whose origin matches a `remote:` (a git URL or owner/repo) in the
# project registry ~/.config/projects.yaml (D72) gets that name; every other
# clone is keyed by its path relative to $HOME, so two clones with the same
# basename stay distinct. A second clone of a named remote keeps its path key.
# A summary goes to stderr; --report also lists named projects with no clone
# here and unnamed clones (candidates for the registry).
#
# Usage: mani-discover [--dry-run] [--report]   (--dry-run prints the YAML instead)
# Override the roots: MANI_DISCOVER_ROOTS="$HOME/a $HOME/b" mani-discover

set -euo pipefail

OUT="${HOME}/mani.yaml"
read -r -a roots <<<"${MANI_DISCOVER_ROOTS:-{{ range $i, $r := .registry.scan_roots }}{{ if $i }} {{ end }}{{ $r | replace "~/" "$HOME/" }}{{ end }}}"
fixed=("{{ .chezmoi.workingTree }}" "$HOME/.claude/projects")

REGISTRY="${XDG_CONFIG_HOME:-$HOME/.config}/projects.yaml"
dry_run=0
report=0
for arg in "$@"; do
    case $arg in
        --dry-run) dry_run=1 ;;
        --report) report=1 ;;
        *) echo "mani-discover: unknown argument: $arg" >&2; exit 2 ;;
    esac
done

found="$(mktemp)"
trap 'rm -f "$found" "$OUT.tmp" "$OUT.dry"' EXIT

{
    for root in "${roots[@]}"; do
        [ -d "$root" ] || continue
        fd --hidden --no-ignore --type d --max-depth 5 \
            --exclude node_modules --exclude .venv --exclude .cache \
            '^\.git$' "$root" --exec dirname {}
    done
    for repo in "${fixed[@]}"; do
        # if, not &&: a missing last repo must not fail the pipeline (pipefail, set -e).
        if [ -d "$repo/.git" ]; then echo "$repo"; fi
    done
} | sort -u >"$found"

# The match key of a remote (bd-track's registry-schema.md, "Remotes"; same as ticket's
# remote_key): its path, lowercased, without .git or edge slashes, host ignored. Takes any
# URL form git accepts (scp-like, ssh://, https://; host aliases), a local path, or the
# owner/repo shorthand; nested paths keep every component. Prints nothing for fewer than two
# path components or whitespace.
remote_key() {
    local text=$1 path part
    text=${text#"${text%%[![:space:]]*}"}
    text=${text%"${text##*[![:space:]]}"}
    text=${text#git+}
    [[ -n $text && $text != *[[:space:]]* ]] || return 0
    if [[ $text =~ ^[A-Za-z][A-Za-z0-9+.-]*:// ]]; then
        path=${text#*://}
        [[ $path == */* ]] && path=${path#*/} || path=""
    elif [[ $text =~ ^([^@/:[:space:]]+@)?[^/:[:space:]]+:(.*)$ && ${BASH_REMATCH[2]} != //* && $text != [/~.]* ]]; then
        path=${BASH_REMATCH[2]}
    else
        path=$text
    fi
    while [[ $path == /* ]]; do path=${path#/}; done
    while [[ $path == */ ]]; do path=${path%/}; done
    path=${path%.git}
    path=${path#\~/}
    while [[ $path == /* ]]; do path=${path#/}; done
    while [[ $path == */ ]]; do path=${path%/}; done
    local -a split parts=()
    IFS=/ read -ra split <<<"$path"
    for part in "${split[@]}"; do
        [[ -n $part && $part != . ]] && parts+=("$part")
    done
    ((${#parts[@]} >= 2)) || return 0
    local IFS=/
    printf '%s\n' "${parts[*],,}"
}

# "<remote> name" and "path:<abs> name" lines from the registry (none without one); remotes
# are keyed by remote_key, so a full URL and the owner/repo shorthand match alike.
declare -A name_of=()
registry_names=()
if [ -r "$REGISTRY" ] && ! command -v yq >/dev/null; then
    echo "mani-discover: yq not found; $REGISTRY ignored, every clone keyed by path" >&2
elif [ -r "$REGISTRY" ]; then
    while read -r key name; do
        [ -n "$key" ] || continue
        registry_names+=("$name")
        if [[ $key != path:* ]]; then
            norm=$(remote_key "$key")
            if [ -z "$norm" ]; then
                echo "mani-discover: $name: remote '$key' is not a git URL or owner/repo; ignored" >&2
                continue
            fi
            key=$norm
        fi
        name_of[$key]=$name
    # An entry with a path matches that clone only (it pins one of several clones of a remote).
    # (mikefarah yq: explicit null tests; jq's `//` and `| not` idioms do not carry over.)
    done < <(yq -r '(.projects | select(. != null) | to_entries[]) |
        ((select(.value.path != null) | "path:" + .value.path + " " + .key),
         (select(.value.path == null and .value.remote != null) | .value.remote + " " + .key))' "$REGISTRY" |
        sed "s|^path:~/|path:$HOME/|")
fi

declare -A used=()
unnamed=()
render() {
    echo "# Generated by mani-discover on $(date +%F); do not edit, re-run it instead (D35)."
    echo "# Names come from $REGISTRY; other clones are keyed by path."
    echo "projects:"
    while IFS= read -r repo; do
        local key="" url rkey=""
        url=$(git -C "$repo" remote get-url origin 2>/dev/null || true)
        [ -z "$url" ] || rkey=$(remote_key "$url")
        if [ -n "$rkey" ] && [ -n "${name_of[$rkey]:-}" ]; then
            key=${name_of[$rkey]}
        elif [ -n "${name_of["path:$repo"]:-}" ]; then
            key=${name_of["path:$repo"]}
        fi
        if [ -n "$key" ] && [ -n "${used[$key]:-}" ]; then
            echo "mani-discover: $repo is a second clone of '$key' (${used[$key]}); keyed by path" >&2
            key=""
        fi
        if [ -n "$key" ]; then
            used[$key]=$repo
        else
            key=${repo#"$HOME"/}
            unnamed+=("$key")
        fi
        printf '  "%s":\n    path: "%s"\n' "$key" "$repo"
    done <"$found"
}

summary() {
    local missing=() name
    for name in "${registry_names[@]}"; do
        [ -n "${used[$name]:-}" ] || missing+=("$name")
    done
    echo "mani-discover: ${#used[@]} of ${#registry_names[@]} registry project(s) found, ${#unnamed[@]} clone(s) unnamed" >&2
    if [ "${#missing[@]}" -gt 0 ]; then
        echo "mani-discover: no clone here for: ${missing[*]}" >&2
    fi
    if [ "$report" -eq 1 ] && [ "${#unnamed[@]}" -gt 0 ]; then
        printf 'mani-discover: unnamed: %s\n' "${unnamed[@]}" >&2
    fi
}

# render runs in this shell (not a pipeline subshell) so summary sees its tallies.
if [ "$dry_run" -eq 1 ]; then
    render >"$OUT.dry"
    cat "$OUT.dry"
    rm -f "$OUT.dry"
else
    render >"$OUT.tmp" && mv "$OUT.tmp" "$OUT"
    echo "mani-discover: wrote $(grep -c '^    path:' "$OUT") project(s) to $OUT"
fi
summary
{{ end -}}
