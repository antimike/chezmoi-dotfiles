#!/usr/bin/env bash
# ticket-picker — file a ticket from the desktop (D72): pick a project, then type.   $mod+t
#
#   1. rofi lists the registry's projects, most recently picked first.
#   2. A one-line rofi prompt for the ticket:
#        Enter        files the line as a quick note (ticket --quick, into inbox.md)
#        Alt+Enter    opens a floating kitty with $EDITOR for a full ticket, the line as
#                     its title (ticket --edit); Enter on an empty line does the same
#        Escape       cancels
#   3. A notification says where it went (or that nothing was filed).
#
# Recent projects: $XDG_STATE_HOME/ticket-picker/recent. For tests, TICKET_PICKER_ROFI and
# TICKET_PICKER_TERM replace `rofi` and the kitty command line (both called with the same
# arguments). Exit status: 0 = filed, 1 = cancelled or nothing filed.
set -euo pipefail

rofi_cmd=${TICKET_PICKER_ROFI:-rofi}
state=${XDG_STATE_HOME:-$HOME/.local/state}/ticket-picker
recent=$state/recent

notify() { notify-send -a ticket "$@" || true; }
# The bar menus' theme (readable input text; rofi's default here, fancy, draws it white on light
# grey), centred instead of under the bar.
theme=(-theme bar-menu -theme-str 'window { location: center; anchor: center; x-offset: 0; y-offset: 0; width: 44em; }')

for cmd in ticket "$rofi_cmd"; do
  command -v "$cmd" >/dev/null 2>&1 || { notify "ticket-picker" "'$cmd' not found"; exit 1; }
done

projects=$(ticket --projects 2>&1) || { notify "ticket-picker" "$projects"; exit 1; }

# Recent names still in the registry first, then the rest in registry order.
ordered=$( { [[ -r $recent ]] && grep -Fxf <(printf '%s\n' "$projects") "$recent"; printf '%s\n' "$projects"; } |
  awk 'NF && !seen[$0]++')

project=$(printf '%s\n' "$ordered" | "$rofi_cmd" "${theme[@]}" -dmenu -i -no-custom -p "Ticket for" \
  -theme-str 'entry { placeholder: "project"; }') || exit 1
[[ -n $project ]] || exit 1

mkdir -p "$state"
{ echo "$project"; [[ -r $recent ]] && grep -Fxv -- "$project" "$recent"; } | head -20 >"$recent.tmp" || true
mv "$recent.tmp" "$recent"

rc=0
text=$("$rofi_cmd" "${theme[@]}" -theme-str 'entry { placeholder: "one line"; }' \
  -dmenu -l 0 -p "$project" -kb-custom-1 Alt+Return \
  -mesg "Enter: quick note · Alt+Enter: full ticket in the editor (this line is its title)" </dev/null) || rc=$?
case $rc in
  0) [[ -n ${text//[[:space:]]/} ]] && mode=quick || mode=edit ;;
  10) mode=edit ;;
  *) exit 1 ;;
esac

if [[ $mode == quick ]]; then
  if out=$(ticket -q -p "$project" -- "$text" 2>&1); then
    notify "Quick note for $project" "$text"
    exit 0
  fi
  notify -u critical "Ticket not filed" "$out"
  exit 1
fi

result=$(mktemp)
trap 'rm -f "$result"' EXIT
# shellcheck disable=SC2016  # expanded by the inner sh
# On failure the window stays open, so the error can be read.
script='ticket -p "$1" --edit -- "$2" >"$3" || { printf "\nNothing filed. Press Enter to close. "; read -r _; }'
if [[ -n ${TICKET_PICKER_TERM:-} ]]; then
  read -ra term <<<"$TICKET_PICKER_TERM"
else
  # In $HOME, so mise reads ~/.tool-versions (the pinned nvim).
  term=(kitty --class ticket-editor --title "New ticket: $project" --directory "$HOME")
fi
"${term[@]}" sh -c "$script" sh "$project" "$text" "$result" || true
if [[ -s $result ]]; then
  notify "Ticket filed for $project" "$(cat "$result")"
  exit 0
fi
notify "No ticket filed" "the editor was left empty or closed"
exit 1
