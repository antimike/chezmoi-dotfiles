#!/usr/bin/env bash
# clip — copy stdin to the clipboard, on Wayland or X11.
#
#   command | clip                         copy (wl-copy on Wayland, xclip -sel clip on X11)
#   command | clip --private               same, but marked sensitive so cliphist skips it
#   command | clip --no-trailing-newline   drop one trailing newline (pwd | clip -n)
#
# Flags combine (clip -pn). Wayland is picked when $WAYLAND_DISPLAY is set. On X11
# nothing records clipboard history, so --private changes nothing there.
set -euo pipefail

usage() { echo "usage: command | clip [-p|--private] [-n|--no-trailing-newline]" >&2; exit 2; }

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "clip: '$1' not found" >&2; exit 127; }
}

private=0
trim=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -p | --private) private=1 ;;
    -n | --no-trailing-newline) trim=1 ;;
    -pn | -np) private=1; trim=1 ;;
    -h | --help) usage ;;
    *) usage ;;
  esac
  shift
done

if [[ -t 0 ]]; then
  echo "clip: nothing on stdin (pipe something in)" >&2
  exit 2
fi

if [[ -n "${WAYLAND_DISPLAY:-}" ]]; then
  need wl-copy
  args=()
  ((private)) && args+=(--sensitive)
  ((trim)) && args+=(--trim-newline)
  exec wl-copy "${args[@]}"
elif [[ -n "${DISPLAY:-}" ]]; then
  need xclip
  if ((trim)); then
    # xclip has no trim option; strip one trailing newline, as wl-copy -n does.
    need perl
    perl -0777 -pe 's/\n\z//' | xclip -selection clipboard
  else
    exec xclip -selection clipboard
  fi
else
  echo "clip: no graphical session (neither WAYLAND_DISPLAY nor DISPLAY is set)" >&2
  exit 1
fi
