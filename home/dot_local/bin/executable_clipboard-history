#!/usr/bin/env bash
# clipboard-history — pick an entry from the cliphist history and put it back on
# the clipboard.
#
#   clipboard-history          fuzzy-pick with fzf, copy the choice with wl-copy
#   clipboard-history --menu   the same with fuzzel, no terminal needed ($mod+v in Hyprland);
#                              no preview: multi-line entries show their first line
#   clipboard-history --list   print the history (what cliphist list prints)
#
# History is recorded by the clipboard-stack-wayland.target user units (see
# ~/.config/systemd/user). Copies marked sensitive (wl-copy --sensitive) are never
# recorded. Run clipboard-history-audit to look for secrets that slipped in.
set -euo pipefail

need() {
  command -v "$1" >/dev/null 2>&1 || { echo "clipboard-history: '$1' not found" >&2; exit 127; }
}

need cliphist
case "${1:-}" in
  --list) exec cliphist list ;;
  --menu | "") ;;
  *) echo "usage: clipboard-history [--menu | --list]" >&2; exit 2 ;;
esac
need wl-copy

if [[ ${1:-} == --menu ]]; then
  need fuzzel
  # Shows the preview column; prints the whole "ID<TAB>preview" line for cliphist decode.
  selection=$(cliphist list | fuzzel --dmenu --only-match --with-nth=2 --prompt='clipboard ') || exit 0
  [ -n "$selection" ] || exit 0
  printf '%s' "$selection" | cliphist decode | wl-copy
  exit 0
fi

need fzf

# Lines look like "ID<TAB>preview"; images show as "[[ binary data ... ]]". The
# preview pane shows text entries in full and just the label for binary ones.
selection=$(cliphist list | fzf --no-sort --reverse --height=60% \
  --delimiter=$'\t' --with-nth=2.. --prompt='clipboard> ' \
  --preview 'case {2..} in "[[ binary"*) printf "%s\n" {2..} ;; *) cliphist decode {1} | head -n 60 ;; esac' \
  --preview-window=right,50%,wrap) || exit 0
[ -n "$selection" ] || exit 0

printf '%s' "$selection" | cliphist decode | wl-copy
