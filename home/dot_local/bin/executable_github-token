#!/usr/bin/env bash
# github-token — print this host's GitHub token from pass, for .envrc files.
#
#   github-token           print tokens/github/<host>, else tokens/github/default
#   github-token --check   report which entries exist, without decrypting (exit 1 if neither)
#   github-token --new     open GitHub's new-token page, then print the pass insert command
#
# <host> is the short hostname (${HOST%%.*}). Each host should get its own token so one
# can be revoked alone; until it has one, the shared default is used and a note goes to
# stderr. Usage in an .envrc:
#   export GITHUB_TOKEN="$(github-token)"
#   export GH_TOKEN="$GITHUB_TOKEN"
set -euo pipefail

host="$(hostname -s 2>/dev/null || hostname)"
host="${host%%.*}"
store="${PASSWORD_STORE_DIR:-$HOME/.password-store}"
own="tokens/github/$host"
default="tokens/github/default"
new_url="https://github.com/settings/personal-access-tokens/new"

has() { [[ -f "$store/$1.gpg" ]]; }

case "${1-}" in
  "")
    if has "$own"; then
      pass show "$own" | head -1
    elif has "$default"; then
      echo "github-token: no $own in pass; using $default" >&2
      pass show "$default" | head -1
    else
      echo "github-token: neither $own nor $default is in pass (github-token --new)" >&2
      exit 1
    fi
    ;;
  --check)
    status=1
    for entry in "$own" "$default"; do
      if has "$entry"; then echo "present: $entry"; status=0; else echo "missing: $entry"; fi
    done
    exit "$status"
    ;;
  --new)
    xdg-open "$new_url" >/dev/null 2>&1 || echo "open: $new_url"
    echo "then: pass insert $own   (or $default for the shared one)"
    ;;
  *)
    echo "usage: github-token [--check|--new]" >&2
    exit 2
    ;;
esac
