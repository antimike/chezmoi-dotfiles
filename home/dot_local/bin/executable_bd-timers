#!/usr/bin/env bash
# bd-timers — pause and resume bd-track timers from the desktop (chz-dg6).
#
#   bd-timers toggle      $mod+Ctrl+t   any open interval: pause every open one (all projects);
#                                       none open: resume every paused one
#   bd-timers pick        $mod+Ctrl+Shift+t   rofi list of open (▶) and paused (⏸) intervals;
#                                       Enter pauses or resumes the chosen one
#   bd-timers pause-all   idle and sleep hooks (lock_cmd / before_sleep_cmd in hypridle,
#                                       lock / before-sleep in swayidle); no notification
#                                       when nothing was open, never fails
#
# Every mode notifies what changed. Data: `bd-track --global active --json`; actions:
# `bd-track --global pause|resume --all` and, for one interval,
# `bd-track --project <path> pause|resume --all <bead>`.
# For tests, BD_TIMERS_BDTRACK and BD_TIMERS_ROFI replace `bd-track` and `rofi` (called with
# the same arguments), and BD_TIMERS_NOTIFY replaces `notify-send`.
# Exit status: 0 = done (or nothing to do), 1 = cancelled or bd-track failed, 2 = usage.
set -euo pipefail

bdt=${BD_TIMERS_BDTRACK:-bd-track}
rofi_cmd=${BD_TIMERS_ROFI:-rofi}
notify_cmd=${BD_TIMERS_NOTIFY:-notify-send}

notify() { "$notify_cmd" -a bd-timers "$@" 2>/dev/null || true; }
usage() { echo "usage: bd-timers toggle|pick|pause-all" >&2; exit 2; }

# active intervals as TSV: state, project, bead, title, since (HH:MM)
active() {
  "$bdt" --global active --json 2>/dev/null |
    jq -r '.[] | [.state, .project, .bead, (.title // "" | gsub("\t"; " ")),
                  (.since // "" | .[11:16])] | @tsv'
}

# beads of the given state, comma-separated
beads_in() { awk -F'\t' -v s="$1" '$1 == s { print $3 }' <<<"$2" | paste -sd, - | sed 's/,/, /g'; }

all() { # all pause|resume <state-before> <rows>
  local verb=$1 state=$2 rows=$3 beads out
  beads=$(beads_in "$state" "$rows")
  if ! out=$("$bdt" --global "$verb" --all 2>&1); then
    notify -u critical "bd-track $verb failed" "$out"
    return 1
  fi
  if [[ $verb == pause ]]; then notify "Timers paused" "$beads"; else notify "Timers resumed" "$beads"; fi
}

cmd=${1:-}
[[ $# -le 1 ]] || usage
case $cmd in
  toggle)
    rows=$(active)
    if grep -q $'^open\t' <<<"$rows"; then
      all pause open "$rows"
    elif grep -q $'^paused\t' <<<"$rows"; then
      all resume paused "$rows"
    else
      notify "No timers" "nothing open or paused"
    fi
    ;;
  pause-all)
    rows=$(active)
    grep -q $'^open\t' <<<"$rows" || exit 0
    all pause open "$rows" || true
    ;;
  pick)
    command -v "$rofi_cmd" >/dev/null 2>&1 || { notify "bd-timers" "'$rofi_cmd' not found"; exit 1; }
    rows=$(active)
    if [[ -z $rows ]]; then
      notify "No timers" "nothing open or paused"
      exit 0
    fi
    # One line per interval; rofi returns the index (-format i), so titles never get parsed back.
    menu=$(awk -F'\t' '{ printf "%s  %-12s %s  · %s %s\n", ($1 == "open" ? "▶" : "⏸"), $3, $4,
                         gensub(".*/", "", 1, $2), $5 }' <<<"$rows")
    idx=$(printf '%s\n' "$menu" | "$rofi_cmd" -theme bar-menu \
      -theme-str 'window { location: center; anchor: center; x-offset: 0; y-offset: 0; width: 60em; }' \
      -dmenu -i -no-custom -format i -p "Timers" \
      -mesg "Enter: pause ▶ / resume ⏸ the chosen timer") || exit 1
    [[ $idx =~ ^[0-9]+$ ]] || exit 1
    IFS=$'\t' read -r state project bead title _ < <(sed -n "$((idx + 1))p" <<<"$rows")
    if [[ $state == open ]]; then verb=pause; else verb=resume; fi
    if ! out=$("$bdt" --project "$project" "$verb" --all "$bead" 2>&1); then
      notify -u critical "bd-track $verb failed" "$out"
      exit 1
    fi
    if [[ $verb == pause ]]; then notify "Timer paused" "$bead  $title"; else notify "Timer resumed" "$bead  $title"; fi
    ;;
  *) usage ;;
esac
