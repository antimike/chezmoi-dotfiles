#!/usr/bin/env bash
# etckeeper-secret-audit -- verify that every non-world-readable file
# under /etc is either (a) properly excluded by /etc/.gitignore, or
# (b) not currently tracked by the etckeeper repo.
#
# Reports two failure modes:
#   TRACKED     - file is in the repo's index despite being restricted;
#                 a previous commit captured it before the gitignore
#                 was tightened. Untrack with:
#                     sudo git -C /etc rm --cached <path>
#                     sudo etckeeper commit "untrack <path>"
#                 (Note: history is not purged. For a freshly-init'd
#                  repo, prefer `etckeeper uninit -f` then fix the
#                  gitignore then re-init.)
#
#   NOT IGNORED - file is untracked but no gitignore rule matches; it
#                 would be swept in by the next `git add -A`. Add a
#                 matching pattern to /etc/.gitignore and re-run.
#
# Implementation: builds three sorted streams of paths relative to /etc
# (restricted-by-mode, tracked, untracked-and-not-ignored) and uses
# `comm -12` for set intersection. Forks git exactly twice rather than
# once per file, so it scales cleanly on large /etc trees.
#
# Uses `find -L` so symlinks (e.g. /etc/letsencrypt/live/*/privkey.pem
# resolving into archive/) are followed to their targets; either path
# being ignored counts as a pass.
#
# Caveat: world-readable (mode &004) files are skipped entirely. The
# audit assumes secrets are mode 0600/0640 by convention. If a 0644
# file contains a private key, this script will not catch it -- use a
# content-grep for that case (BEGIN PRIVATE KEY, etc.).
#
# Usage: sudo etckeeper-secret-audit
# Exit:  0 if all restricted files are ignored/untracked, 1 otherwise,
#        2 on precondition failure (not root, no etckeeper repo).

set -u

if [ "$(id -u)" -ne 0 ]; then
    if ! command -v sudo >/dev/null 2>&1; then
        echo "etckeeper-secret-audit: must run as root" >&2
        exit 2
    fi
    exec sudo -E "$0" "$@"
fi

if [ ! -d /etc/.git ]; then
    echo "etckeeper-secret-audit: /etc/.git not found -- is etckeeper initialized?" >&2
    exit 2
fi

cd /etc || exit 2

# Three sorted streams of paths, all relative to /etc.
#
# `find -printf '%P\n'` strips the /etc/ prefix at the source so the
# output collates with `git ls-files`, which always reports repo-
# relative paths. Both git invocations emit sorted output already; the
# explicit `sort -u` is defensive in case that ever changes and ensures
# `comm` sees the strict ordering it requires.

mapfile -t restricted < <(
    find -L /etc -type f ! -perm -o=r -printf '%P\n' 2>/dev/null | sort -u
)
mapfile -t tracked < <(
    git ls-files | sort -u
)
mapfile -t unignored < <(
    git ls-files --others --exclude-standard | sort -u
)

# Set intersections via `comm -12` (lines common to both inputs).
# Both inputs must already be sorted, which they are.

mapfile -t tracked_bad < <(
    comm -12 \
        <(printf '%s\n' "${restricted[@]}") \
        <(printf '%s\n' "${tracked[@]}")
)
mapfile -t unignored_bad < <(
    comm -12 \
        <(printf '%s\n' "${restricted[@]}") \
        <(printf '%s\n' "${unignored[@]}")
)

# Report. `"${arr[@]}"` quoting is required so paths containing spaces
# survive intact through printf.

(( ${#tracked_bad[@]} ))   && printf 'TRACKED       %s\n' "${tracked_bad[@]}"
(( ${#unignored_bad[@]} )) && printf 'NOT IGNORED   %s\n' "${unignored_bad[@]}"

if (( ${#tracked_bad[@]} == 0 && ${#unignored_bad[@]} == 0 )); then
    echo "OK: all restricted files in /etc are properly ignored or untracked"
    exit 0
fi

bad=$(( ${#tracked_bad[@]} + ${#unignored_bad[@]} ))
{
    echo
    echo "FAIL: $bad restricted file(s) need attention."
    echo "  TRACKED     -> sudo git -C /etc rm --cached <path> ; sudo etckeeper commit \"untrack <path>\""
    echo "  NOT IGNORED -> add pattern to /etc/.gitignore and re-run this audit"
} >&2
exit 1
