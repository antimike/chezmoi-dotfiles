{{ if lookPath "git" -}}
#!/usr/bin/env bash
# sync-repos: daily git auto-commit + push for every project in the registry
# (`pproj where registry`; $PPROJ_REGISTRY overrides it) with `sync: {enabled: true}`
# (D75). Invoked by
# sync-repos.service (systemd user unit), triggered by sync-repos.timer.
#
# A synced project needs a `path:` (D36: only data repos with a fixed, known
# path). `sync` is sync-repos' namespace in the registry (one block per client,
# D75); `sync.enabled` must be a YAML boolean, and anything else (including `yes`,
# a string in YAML 1.2), a `sync` that is not a mapping, or the old flat key
# `sync_repo` is reported as a failure and that project is skipped.
#
# Per-repo behavior (D36):
#   - `git add -A`; if anything is staged, scan it with gitleaks *here* (never
#     rely on a per-clone hook) and refuse to commit on a finding or when
#     gitleaks is missing; then commit "chore(sync): <host> <UTC time>"
#   - If an upstream is configured: `git pull --rebase --autostash`, then push.
#     A failed rebase is aborted, so the repo is never left mid-rebase.
#   - Errors in one repo do not abort the rest; any failure sends one
#     notification (via ~/.claude/scripts/notify) and a non-zero exit, so
#     systemd retries (Restart=on-failure in the service).
#
# Safe to run manually alongside the timer: flock guards against overlap.

set -euo pipefail

# SYNC_REPOS_NOTIFY exists for testing; the registry comes from pproj (PPROJ_REGISTRY).
LOCK="${XDG_RUNTIME_DIR:-/tmp}/sync-repos.lock"
NOTIFY="${SYNC_REPOS_NOTIFY:-${HOME}/.claude/scripts/notify}"

log() { logger -t sync-repos -- "$*"; echo "sync-repos: $*" >&2; }

# Executable-dependency guard: git is template-guarded above; flock, logger and
# yq (mikefarah's, for the registry) are checked here. gitleaks is checked per
# commit, so a missing gitleaks still lets already-made commits be pushed.
for cmd in flock logger yq; do
    command -v "$cmd" >/dev/null 2>&1 || {
        echo "sync-repos: missing required command: $cmd" >&2
        exit 2
    }
done

# One resolver for the registry path (chz-37d); no fallback without pproj. Notify:
# this runs from a timer, where stderr goes unread.
if ! command -v pproj >/dev/null 2>&1; then
    msg="pproj not found; it locates the project registry (chezmoi pin: .chezmoidata/project_registry.yaml)"
    log "$msg"
    [ -x "$NOTIFY" ] && { "$NOTIFY" --urgent "sync-repos failed" "$msg" || true; }
    exit 1
fi
REGISTRY="$(pproj where registry)"

[ -r "$REGISTRY" ] || { log "no registry at $REGISTRY; nothing to do"; exit 0; }

exec 9>"$LOCK"
flock -n 9 || { log "another instance holds the lock; exiting"; exit 0; }

# After boot or resume the timer (Persistent=true) can fire before the network
# is up; wait briefly instead of failing the push. Retries beyond this are the
# service's Restart=on-failure.
if command -v nm-online >/dev/null 2>&1; then
    nm-online -q -t 120 || log "network not online after 120s; trying anyway"
fi

stamp="$(hostname) $(date -u +%Y-%m-%dT%H:%MZ)"

# Why a pull/push probably failed. Asking scdaemon for the card serial needs no
# PIN, so it tells "key absent" apart from "key present but the PIN prompt went
# unanswered" (gpg-agent's pinentry times out and the agent refuses to sign).
auth_hint() {
    local reply
    if [ -n "${GIT_SSH_COMMAND:-}" ]; then
        echo "network, or deploy key rejected (added on GitHub with write access?)"
        return
    fi
    reply="$(gpg-connect-agent 'scd serialno' /bye 2>/dev/null || true)"
    case "$reply" in
        *"S SERIALNO"*) echo "network, or YubiKey PIN prompt unanswered: agent refused" ;;
        *) echo "network, or YubiKey not plugged in" ;;
    esac
}

# Prints the reason and returns non-zero on failure.
sync_one() {
    local repo="$1"
    cd "$repo" || { echo "cannot cd"; return 1; }

    # git's own output goes to stderr (the journal); stdout carries only the
    # failure reason, which the caller captures.
    git add -A >&2
    if ! git diff --cached --quiet; then
        command -v gitleaks >/dev/null 2>&1 \
            || { echo "gitleaks not installed; refusing to commit"; return 1; }
        gitleaks git --pre-commit --staged --redact --no-banner >&2 \
            || { echo "gitleaks found secrets in staged changes; commit aborted"; return 1; }
        git commit -q -m "chore(sync): ${stamp}" >&2 \
            || { echo "git commit failed"; return 1; }
        log "committed in ${repo}"
    fi

    if ! git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
        log "no upstream for ${repo}; committed locally only"
        return 0
    fi

    # A deploy key from sync-repos-deploy-key (D74), imported by the service,
    # replaces the YubiKey for this repo; without one, ssh uses the agent.
    local slug key
    slug="$(git remote get-url origin 2>/dev/null)" || slug=""
    slug="${slug%.git}"
    slug="${slug##*[:/]}"
    key="${CREDENTIALS_DIRECTORY:-/nonexistent}/sync-repos.${slug}"
    if [ -n "$slug" ] && [ -r "$key" ]; then
        local -x GIT_SSH_COMMAND="ssh -i ${key} -o IdentitiesOnly=yes -o IdentityAgent=none"
        log "using deploy key for ${repo}"
    fi
    if ! git pull --rebase --autostash -q >&2; then
        if [ -d "$(git rev-parse --git-path rebase-merge)" ] \
           || [ -d "$(git rev-parse --git-path rebase-apply)" ]; then
            git rebase --abort >&2 || true
            echo "rebase conflict with upstream (aborted); resolve by hand"
        else
            echo "git pull failed ($(auth_hint))"
        fi
        return 1
    fi
    git push -q >&2 || { echo "git push failed ($(auth_hint))"; return 1; }
    log "pushed ${repo}"
}

failures=()

# One TSV line per project that sets sync or the old sync_repo: name, whether sync_repo
# is set, the YAML tags of sync and sync.enabled, enabled's value, path.
# (mikefarah yq: explicit null tests; see mani-discover.)
if ! entries="$(yq -r '(.projects | select(. != null) | to_entries[])
        | select(.value.sync_repo != null or .value.sync != null)
        | [.key, ((.value.sync_repo != null) | tostring), (.value.sync | tag),
           ((.value.sync | select(tag == "!!map") | .enabled | tag) // "!!null"),
           ((.value.sync | select(tag == "!!map") | .enabled | tostring) // ""),
           ((.value.path | select(. != null)) // "")] | @tsv' "$REGISTRY")"; then
    log "cannot parse $REGISTRY"
    failures+=("${REGISTRY/#"$HOME"/\~}: cannot parse")
    entries=""
fi

repos=()
while IFS=$'\t' read -r name old sync_tag tag value path; do
    [ -z "$name" ] && continue
    if [ "$old" = "true" ]; then
        failures+=("${name}: sync_repo is renamed to sync.enabled (sync: {enabled: true})")
        continue
    fi
    if [ "$sync_tag" != "!!map" ]; then
        failures+=("${name}: sync must be a mapping (sync: {enabled: true}), not ${sync_tag#!!}")
        continue
    fi
    [ "$tag" = "!!null" ] && continue
    if [ "$tag" != "!!bool" ]; then
        failures+=("${name}: sync.enabled must be true or false, not '${value}'")
        continue
    fi
    [ "$value" = "true" ] || continue
    if [ -z "$path" ]; then
        failures+=("${name}: sync.enabled is true but there is no path")
        continue
    fi
    repos+=("${path/#\~/$HOME}")
done <<<"$entries"

[ "${#repos[@]}" -gt 0 ] || [ "${#failures[@]}" -gt 0 ] \
    || { log "no project with sync.enabled: true in $REGISTRY; nothing to do"; exit 0; }

for repo in "${repos[@]}"; do
    if [ ! -d "$repo/.git" ]; then
        log "skip: $repo has no .git directory"
        failures+=("${repo/#"$HOME"/\~}: no .git directory")
        continue
    fi

    if ! reason="$(sync_one "$repo")"; then
        log "error syncing ${repo}: ${reason}"
        failures+=("${repo/#"$HOME"/\~}: ${reason}")
    fi
done

if [ "${#failures[@]}" -gt 0 ]; then
    if [ -x "$NOTIFY" ]; then
        "$NOTIFY" --urgent "sync-repos failed (${#failures[@]})" "$(printf '%s\n' "${failures[@]}")" || true
    fi
    exit 1
fi
{{- end }}
