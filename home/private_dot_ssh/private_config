IdentitiesOnly yes

Host QuakerOATI.github.com
    HostName github.com
    IdentityFile ~/.ssh/QuakerOATI.github.25519

Host antimike.github.com
    HostName github.com
    IdentityFile ~/.ssh/yubikey-auth.pub
    IdentityAgent /run/user/1000/gnupg/S.gpg-agent.ssh

# GL-AR750S repeater (docs/runbooks/home-network.md): key-only root login, LAN side only
Host router 192.168.8.1
    HostName 192.168.8.1
    User root
    IdentityFile ~/.ssh/yubikey-auth.pub
    IdentityAgent /run/user/1000/gnupg/S.gpg-agent.ssh
