# .bashrc

# Source global definitions
if [ -f /etc/bashrc ]; then
	. /etc/bashrc
fi

# User specific environment (all shells, so non-interactive ssh commands and
# `bash -c` find the tools in ~/.local/bin)
if ! [[ "$PATH" =~ "$HOME/.local/bin:$HOME/bin:" ]]
then
    PATH="$HOME/.local/bin:$HOME/bin:$PATH"
fi
export PATH

# Everything below is for interactive shells only. Without this guard a
# non-interactive shell that happens to read this file (sshd runs it for remote
# commands) runs pyenv, conda and the gpg-agent setup for nothing.
case $- in
*i*) ;;
*) return ;;
esac

# Uncomment the following line if you don't like systemctl's auto-paging feature:
# export SYSTEMD_PAGER=

# Aliases and environment variables shared with the other shells
[ -f ~/.bash_aliases ] && . ~/.bash_aliases
[ -f ~/.bash_env ] && . ~/.bash_env

# User specific aliases and functions
if [ -d ~/.bashrc.d ]; then
	for rc in ~/.bashrc.d/*; do
		if [ -f "$rc" ]; then
			. "$rc"
		fi
	done
fi

unset rc

# gpg-agent provides SSH authentication (see gpg-agent(1), EXAMPLES). The agent
# is started if needed; zshenv does the same for zsh. Not `eval "$(ssh-agent)"`:
# that starts a new ssh-agent in every shell, only to be overridden here.
gpgconf --launch gpg-agent 2>/dev/null
unset SSH_AGENT_PID
if [ "${gnupg_SSH_AUTH_SOCK_by:-0}" -ne $$ ]; then
	SSH_AUTH_SOCK="$(gpgconf --list-dirs agent-ssh-socket)"
	export SSH_AUTH_SOCK
fi
# pinentry needs the terminal; refresh the agent's tty in case this shell moved
# between a console and a graphical session.
GPG_TTY=$(tty)
export GPG_TTY
gpg-connect-agent updatestartuptty /bye >/dev/null 2>&1

export PYENV_ROOT="$HOME/.pyenv"
command -v pyenv >/dev/null || [ ! -d "$PYENV_ROOT/bin" ] || export PATH="$PYENV_ROOT/bin:$PATH"
if command -v pyenv >/dev/null; then
	eval "$(pyenv init -)"
	# pyenv-virtualenv, when installed
	pyenv commands 2>/dev/null | grep -qx virtualenv-init && eval "$(pyenv virtualenv-init -)"
fi

if [[ -d "$HOME/.asdf" ]]; then
	. "$HOME/.asdf/asdf.sh"
	. "$HOME/.asdf/completions/asdf.bash"
fi
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
set -o vi
# History search with Ctrl-P / Ctrl-N in vi insert mode
bind -m vi-insert 'C-p:previous-history'
bind -m vi-insert 'C-n:next-history'

# Tool integrations, each only when the tool is installed. mise output embeds
# the current PATH, so it is evaluated at startup rather than stored.
if command -v mise >/dev/null; then
	eval "$(mise activate bash)"
	eval "$(mise completion bash 2>/dev/null)"
fi
command -v chezmoi >/dev/null && eval "$(chezmoi completion bash)"
command -v direnv >/dev/null && eval "$(direnv hook bash)"

# claude-mem worker (held with the claude-mem evaluation; inert without bun)
if [ -x "$HOME/.bun/bin/bun" ]; then
	alias claude-mem='$HOME/.bun/bin/bun "$(ls -dt $HOME/.claude/plugins/cache/thedotmack/claude-mem/[0-9]*/ 2>/dev/null | head -1)scripts/worker-service.cjs"'
fi

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/usr/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/usr/etc/profile.d/conda.sh" ]; then
        . "/usr/etc/profile.d/conda.sh"
    else
        export PATH="/usr/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<


# Keep ~/.local/bin and ~/bin ahead of system and tool-manager directories.
# conda's hook above prepends /usr/bin (conda lives there), which would put the
# distro packages ahead of the pinned tools the chezmoi installers put in
# ~/.local/bin. Remove any existing entries, then prepend them once. This must
# stay the last thing that touches PATH.
__path=":$PATH:"
__path=${__path//:$HOME\/.local\/bin:/:}
__path=${__path//:$HOME\/bin:/:}
__path=${__path#:}
PATH="$HOME/.local/bin:$HOME/bin:${__path%:}"
unset __path
export PATH
