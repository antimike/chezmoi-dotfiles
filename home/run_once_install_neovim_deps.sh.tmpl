#!/bin/sh

# Python deps
if [ ! -e {{ .filesystem.venvDir | squote }} ]; then
  mkdir -p {{ .filesystem.venvDir | squote }}
fi

VENV={{ joinPath .filesystem.venvDir "neovim" | squote }}

python3 -m venv "$VENV" \
  && "${VENV}/bin/python3" -m pip install --upgrade pip \
  && "${VENV}/bin/python3" -m pip install --upgrade pynvim neovim

# Ruby deps
{{ if eq .chezmoi.osRelease.id "fedora" -}}
sudo dnf install -y ruby ruby-devel rubygems
{{ else -}}
sudo apt-get install -y ruby ruby-rubygems rubygems-integration
{{ end -}}
sudo gem install neovim

# Node deps
{{ if eq .chezmoi.osRelease.id "fedora" -}}
# node/npm ship as versioned Fedora modules (nodejs22, ...) or come from mise;
# only install if npm is missing.
command -v npm >/dev/null 2>&1 || sudo dnf install -y nodejs npm
{{ else -}}
sudo apt-get install -y npm
{{ end -}}
export NPM_INSTALL_PREFIX="${NPM_INSTALL_PREFIX:-{{ .filesystem.npmDir }}}"
mkdir -p "$NPM_INSTALL_PREFIX"
npm config set prefix "$NPM_INSTALL_PREFIX"
npm install -g neovim

# LaTeX
{{ if eq .chezmoi.osRelease.id "fedora" -}}
sudo dnf install -y latexmk biber
{{ else -}}
sudo apt-get install -y latexmk biber
{{ end -}}

# Misc
{{ if eq .chezmoi.osRelease.id "fedora" -}}
# ueberzug is not in Fedora's default repos; image.nvim can use the kitty
# graphics protocol instead, or install ueberzugpp from a COPR if needed.
sudo dnf install -y chafa
{{ else -}}
sudo apt-get install -y chafa ueberzug
{{ end -}}

# Lua rocks toolchain. lazy.nvim builds luarocks (e.g. image.nvim's `magick`)
# against Neovim's LuaJIT/Lua 5.1 via hererocks, since the system luarocks is
# built for Lua 5.4; magick also needs the ImageMagick development headers.
command -v hererocks >/dev/null 2>&1 || pipx install hererocks
{{ if eq .chezmoi.osRelease.id "fedora" -}}
sudo dnf install -y ImageMagick-devel
{{ else -}}
sudo apt-get install -y libmagickwand-dev
{{ end -}}
