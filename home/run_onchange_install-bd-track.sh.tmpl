#!/bin/sh
# run_onchange_install-bd-track.sh.tmpl — install bd-track at a pinned release.
# Pin: .chezmoidata/bd_track.yaml. Logic: .chezmoitemplates/install/pinned-pipx-tool.sh.
# bd (beads) is checked too: bd-track needs it at run time (timew is NOT required).
# bd-track {{ .bdTrack.ref }}
{{ includeTemplate "install/pinned-pipx-tool.sh" (dict
     "name" "bd-track"
     "package" "bd-track"
     "repo_url" .bdTrack.repo_url
     "ref" .bdTrack.ref
     "clone_dir" (joinPath .chezmoi.homeDir .bdTrack.clone_dir)
     "requires" "bd") }}
