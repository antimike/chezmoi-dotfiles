{{ if eq (dig "display_server" "x11" .) "wayland" -}}
-- Hyprland: minimal trial config (docs/plans/wayland-desktop.md, "Hyprland trial").
-- Start it from GDM's "Hyprland (uwsm-managed)" entry (the COPR's hyprland-uwsm
-- package). The question is GPUs, not looks: can it light the laptop panel and
-- both externals at once while NVIDIA renders, smoothly? So no blur, shadows or
-- animations (comparable with the SwayFX sway-perf numbers), and only the keys
-- needed to get around. Hyprland >= 0.55 reads Lua; API stubs:
-- /usr/share/hypr/stubs/hl.meta.lua. Check with: Hyprland --verify-config -c <file>
--
-- GPU order: ~/.config/uwsm/env (D59: NVIDIA first when an external monitor is
-- connected at login); ~/.config/uwsm/env-hyprland has the Intel-first control.

------------------
---- MONITORS ----
------------------
-- Hyprland lays out the outputs itself: kanshi.service skips Hyprland. Same layout
-- as ~/.config/kanshi/config (panel | ASUS 4K scale 1.5 | Dell 1440p, bottom edges
-- of panel and externals aligned). Positions are logical pixels. The panel stays on
-- whatever renders: that is the test.
-- Clamshell: the panel is off while the lid is closed AND another monitor is on, so
-- there is always an output. Undocked, a closed lid suspends with the panel left on:
-- turning it off there left a black panel after resume (libinput re-adds the lid
-- switch at resume, so the lid-open bind never fires) and swaylock with no output,
-- which died when the monitors came back (2026-10-23). Re-evaluated at every config
-- load, on the lid switch binds and on monitor hotplug. Closing the lid while docked
-- does not suspend (logind HandleLidSwitchDocked=ignore; dock-awake's lid lock, D64).
local function lid_closed()
    for _, path in ipairs({ "/proc/acpi/button/lid/LID/state", "/proc/acpi/button/lid/LID0/state" }) do
        local f = io.open(path)
        if f then
            local state = f:read("a")
            f:close()
            return state:find("closed") ~= nil
        end
    end
    return false -- no lid
end
local function other_monitor()
    for _, m in ipairs(hl.get_monitors()) do
        if m.name ~= "eDP-1" then return true end
    end
    return false
end
-- waybar's main bar follows the monitors (waybar-launch: the ASUS, else the panel, else
-- the leftmost); it restarts waybar only when the main monitor changes.
local function bar_reconcile()
    hl.exec_cmd("{{ joinPath .chezmoi.homeDir ".local" "bin" "waybar-launch" }} reconcile")
end
local panel_off -- last state applied; nil until the first sync
local function sync_panel(lid)
    local off = lid and other_monitor()
    if off == panel_off then return end -- enabling the panel fires monitor.added again
    panel_off = off
    hl.monitor({ output = "eDP-1", mode = "preferred", position = "0x360", scale = 1, disabled = off })
    bar_reconcile()
end
sync_panel(lid_closed())
hl.bind("switch:on:Lid Switch",  function() sync_panel(true) end,  { locked = true, description = "Lid closed: panel off while docked" })
hl.bind("switch:off:Lid Switch", function() sync_panel(false) end, { locked = true, description = "Lid opened: panel on" })
hl.on("monitor.added",   function() sync_panel(lid_closed()); bar_reconcile() end)
hl.on("monitor.removed", function() sync_panel(lid_closed()); bar_reconcile() end)
hl.monitor({
    output   = "desc:Ancor Communications Inc ASUS PB287Q 0x0001EC1B",
    mode     = "3840x2160@60",
    position = "1920x0",
    scale    = 1.5,
})
hl.monitor({
    output   = "desc:Dell Inc. DELL U2717D 67YGV84PAUZS",
    mode     = "2560x1440@59.95",
    position = "4480x0",
    scale    = 1,
})
-- Anything else: right of the others, preferred mode.
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = 1 })

-------------------
---- AUTOSTART ----
-------------------
hl.on("hyprland.start", function()
{{- if lookPath "gnome-keyring-daemon" }}
    -- Take over GDM's PAM-unlocked keyring daemon (D51; as in the sway config).
    hl.exec_cmd("gnome-keyring-daemon --start --components=secrets")
{{- end }}
    -- uwsm: export WAYLAND_DISPLAY/HYPRLAND_INSTANCE_SIGNATURE and signal readiness,
    -- then start the shared helpers (clipboard, swayidle, Wi-Fi band watch).
    hl.exec_cmd("uwsm finalize && systemctl --user start --no-block wm-helpers-wayland.target")
end)

-----------------------
---- LOOK AND FEEL ----
-----------------------
hl.config({
    general = {
        gaps_in     = 2,
        gaps_out    = 4,
        border_size = 2,
        col = {
            active_border   = "rgba({{ trimPrefix "#" .i3.colors.fg.default }}ff)",
            inactive_border = "rgba(595959aa)",
        },
        layout = "dwindle",
    },
    decoration = {
        rounding = {{ .i3.gaps.corner_radius }},
        shadow   = { enabled = false },
        blur     = { enabled = false },
    },
    animations = { enabled = false },
    dwindle    = { preserve_split = true },
    misc = {
        force_default_wallpaper = 0,
        disable_hyprland_logo   = true,
    },
    input = {
        kb_layout    = "us",
        -- Focus follows the mouse: on trial in Hyprland and SwayFX (MH, 2026-10-23; i3 stays off).
        follow_mouse = 1,
        -- Match binds by keysym, not keycode: keys-cheatsheet replays binds with wtype,
        -- whose own keymap has other keycodes. Same result with the one US layout.
        resolve_binds_by_sym = true,
    },
})

---------------------
---- KEYBINDINGS ----
---------------------
-- Ported from the i3/SwayFX keys (.chezmoitemplates/wm/common, sway/config.tmpl), without
-- i3-style tiling control (splits, tabbed/stacked containers). Every bind has a
-- description: the cheat sheet (keys-cheatsheet, $mod+slash) lists them from `hyprctl binds`.
local mod = "SUPER"
local term = "kitty"
local bin = "{{ joinPath .chezmoi.homeDir ".local" "bin" }}/"
local function bind(keys, dispatcher, description, opts)
    local o = { description = description } -- a copy: callers share option tables
    for k, v in pairs(opts or {}) do o[k] = v end
    return hl.bind(keys, dispatcher, o)
end
local function run(cmd) return hl.dsp.exec_cmd(cmd) end
local function app(cmd) return hl.dsp.exec_cmd("uwsm app -- " .. cmd) end

-- Apps, session, notifications
bind(mod .. " + Return", app(term), "Terminal")
bind(mod .. " + o", run("fuzzel --launch-prefix='uwsm app -- '"), "App launcher")
local window_switcher = run("rofi -icon-theme {{ .Xresources.icons }} -show-icons -theme fancy -modi window -show window")
bind("XF86LaunchA", window_switcher, "Window switcher")
bind(mod .. " + grave", window_switcher, "Window switcher: all workspaces")
{{- if lookPath "passmenu" }}
-- passmenu (dmenu-wl + wtype under Wayland), as .i3.keys.programs; a fuzzel picker is D40.
bind(mod .. " + p", run("passmenu --type"), "Password picker: type it")
bind(mod .. " + SHIFT + p", run("passmenu"), "Password picker: copy it")
{{- end }}
bind(mod .. " + v", run(bin .. "clipboard-history --menu"), "Clipboard history: pick an entry, copy it")
bind(mod .. " + backslash", run("dunstctl close"), "Close the newest notification")
bind(mod .. " + bracketright", run("dunstctl history-pop"), "Show the last closed notification")
bind(mod .. " + slash", run(bin .. "keys-cheatsheet"), "Key cheat sheet (Enter runs the key)")
bind(mod .. " + SHIFT + q", hl.dsp.window.close(), "Close window")
bind(mod .. " + SHIFT + c", run("hyprctl reload"), "Reload the Hyprland config")
-- Exit (under uwsm, `uwsm stop` ends the session cleanly); hyprland-dialog prints the button.
bind(mod .. " + SHIFT + e",
     run([[sh -c '[ "$(hyprland-dialog --title "Exit Hyprland" --text "Exit Hyprland? This ends the session." --buttons "Exit;Cancel")" = Exit ] && uwsm stop']]),
     "Exit Hyprland (asks first)")
bind(mod .. " + SHIFT + CTRL + e", run("uwsm stop"), "Exit Hyprland now")
bind(mod .. " + Escape", run("loginctl lock-session"), "Lock the screen")
-- Suspend ($mod+Ctrl+Escape) and the power key's short press (logind ignores it) both go
-- through dock-awake: suspend undocked, refuse docked (D61). A 5 s press is a hard power cut.
bind(mod .. " + CTRL + Escape", run(bin .. "dock-awake suspend"), "Suspend (refused while docked)")
bind("XF86PowerOff", run(bin .. "dock-awake power-key"), "Power key: suspend (refused while docked)", { locked = true })
bind(mod .. " + SHIFT + Escape", run(bin .. "idle-toggle"), "Pause/resume the idle timeouts")

-- Volume, media, brightness (shared helpers, as in i3/SwayFX); Shift for 1% steps
local held = { locked = true, repeating = true }
bind("XF86AudioRaiseVolume", run(bin .. "volume up"), "Volume up", held)
bind("XF86AudioLowerVolume", run(bin .. "volume down"), "Volume down", held)
bind("SHIFT + XF86AudioRaiseVolume", run(bin .. "volume up 1"), "Volume up 1%", held)
bind("SHIFT + XF86AudioLowerVolume", run(bin .. "volume down 1"), "Volume down 1%", held)
bind("XF86AudioMute", run(bin .. "volume mute"), "Mute output", { locked = true })
bind("XF86AudioMicMute", run(bin .. "volume mic-mute"), "Mute microphone", { locked = true })
-- The Keychron Q3 Pro's mic key sends a Super+C macro until it is remapped to F20.
bind(mod .. " + c", run(bin .. "volume mic-mute"), "Mute microphone (Keychron mic key)", { locked = true })
for key, action in pairs({ Play = "play-pause", Pause = "pause", Stop = "stop", Next = "next", Prev = "previous" }) do
    bind("XF86Audio" .. key, run("playerctl -p cmus " .. action), "cmus: " .. action, { locked = true })
end
bind("XF86MonBrightnessUp", run(bin .. "brightness up"), "Panel brightness up", held)
bind("XF86MonBrightnessDown", run(bin .. "brightness down"), "Panel brightness down", held)
bind("SHIFT + XF86MonBrightnessUp", run(bin .. "brightness up 1"), "Panel brightness up 1%", held)
bind("SHIFT + XF86MonBrightnessDown", run(bin .. "brightness down 1"), "Panel brightness down 1%", held)
bind("XF86KbdBrightnessUp", run(bin .. "brightness kbd-up"), "Keyboard backlight up", held)
bind("XF86KbdBrightnessDown", run(bin .. "brightness kbd-down"), "Keyboard backlight down", held)

-- Screenshots (~/.local/bin/screenshot). Print is also the Keychron's key; the MX Keys S's
-- screenshot key sends $mod+Shift+s (a firmware macro), so that is a screenshot key everywhere.
local shot = bin .. "screenshot "
bind("Print", run(shot .. "window"), "Screenshot: window or region, to the clipboard")
bind(mod .. " + CTRL + s", run(shot .. "window"), "Screenshot: window or region, to the clipboard")
bind(mod .. " + SHIFT + s", run(shot .. "window"), "Screenshot: window or region, to the clipboard")
bind(mod .. " + CTRL + SHIFT + s", run(shot .. "window --ask"), "Screenshot: window or region, ask where to save")
bind(mod .. " + Print", run(shot .. "window --ask"), "Screenshot: window or region, ask where to save")
bind(mod .. " + CTRL + ALT + s", run(shot .. "desktop --ask"), "Screenshot: all screens, ask where to save")
bind(mod .. " + SHIFT + ALT + s", run(shot .. "desktop --ask"), "Screenshot: all screens, ask where to save")
bind(mod .. " + SHIFT + Print", run(shot .. "desktop --ask"), "Screenshot: all screens, ask where to save")

-- Focus and move: vim keys and arrows
for _, d in ipairs({
    { keys = { "{{ .i3.keys.named.left }}", "Left" },   dir = "left" },
    { keys = { "{{ .i3.keys.named.down }}", "Down" },   dir = "down" },
    { keys = { "{{ .i3.keys.named.up }}", "Up" },       dir = "up" },
    { keys = { "{{ .i3.keys.named.right }}", "Right" }, dir = "right" },
}) do
    for _, key in ipairs(d.keys) do
        bind(mod .. " + " .. key, hl.dsp.focus({ direction = d.dir }), "Focus " .. d.dir)
        bind(mod .. " + SHIFT + " .. key, hl.dsp.window.move({ direction = d.dir }), "Move window " .. d.dir)
    end
end

-- Workspaces and monitors. "e-1"/"e+1": the previous/next existing workspace, all monitors (as i3).
for i = 1, 10 do
    local key = i % 10 -- 10 is key 0
    bind(mod .. " + " .. key, hl.dsp.focus({ workspace = i }), "Workspace " .. i)
    bind(mod .. " + SHIFT + " .. key, hl.dsp.window.move({ workspace = i }), "Move window to workspace " .. i)
end
bind(mod .. " + Tab", hl.dsp.focus({ workspace = "previous" }), "Previous workspace (back and forth)")
for _, key in ipairs({ "Left", "{{ .i3.keys.named.left }}" }) do
    bind(mod .. " + ALT + " .. key, hl.dsp.focus({ workspace = "e-1" }), "Previous workspace")
    bind(mod .. " + ALT + SHIFT + " .. key, hl.dsp.window.move({ workspace = "e-1" }), "Move window to the previous workspace")
end
for _, key in ipairs({ "Right", "{{ .i3.keys.named.right }}" }) do
    bind(mod .. " + ALT + " .. key, hl.dsp.focus({ workspace = "e+1" }), "Next workspace")
    bind(mod .. " + ALT + SHIFT + " .. key, hl.dsp.window.move({ workspace = "e+1" }), "Move window to the next workspace")
end
bind(mod .. " + ALT + o", hl.dsp.focus({ monitor = "+1" }), "Focus the next monitor")
bind(mod .. " + CTRL + o", hl.dsp.window.move({ monitor = "+1" }), "Move window to the next monitor")
bind(mod .. " + SHIFT + o", hl.dsp.workspace.move({ monitor = "+1" }), "Move workspace to the next monitor")

-- Windows
bind(mod .. " + f", hl.dsp.window.fullscreen({ action = "toggle" }), "Fullscreen")
bind(mod .. " + SHIFT + f", hl.dsp.window.fullscreen({ mode = "maximized", action = "toggle" }), "Maximize (keeps gaps and bar)")
bind(mod .. " + SHIFT + space", hl.dsp.window.float({ action = "toggle" }), "Toggle floating")
-- i3's "focus mode_toggle": from a floating window to a tiled one on the workspace, or back.
bind(mod .. " + space", function()
    local w = hl.get_active_window()
    if not w then return end
    for _, other in ipairs(hl.get_windows({ workspace = w.workspace, mapped = true })) do
        if other.floating ~= w.floating then
            hl.dispatch(hl.dsp.focus({ window = "address:" .. other.address }))
            return
        end
    end
end, "Focus floating <-> tiled")
bind(mod .. " + SHIFT + t", hl.dsp.window.pin({ action = "toggle" }), "Pin (floating window on every workspace)")
bind(mod .. " + ALT + c", hl.dsp.window.center(), "Center floating window")
bind(mod .. " + e", hl.dsp.layout("togglesplit"), "Toggle split direction (dwindle)")
-- Scratchpad: a special workspace; it shows all its windows at once (i3 cycles them).
bind(mod .. " + CTRL + x", hl.dsp.window.move({ workspace = "special:scratchpad" }), "Move window to the scratchpad")
bind(mod .. " + CTRL + SHIFT + x", hl.dsp.workspace.toggle_special("scratchpad"), "Show/hide the scratchpad")
hl.bind(mod .. " + mouse:272", hl.dsp.window.drag(),   { mouse = true, description = "Drag window" })
hl.bind(mod .. " + mouse:273", hl.dsp.window.resize(), { mouse = true, description = "Resize window" })

-- Marks (i3's marks as window tags; ~/.local/bin/hypr-mark asks with fuzzel)
bind(mod .. " + m", run(bin .. "hypr-mark set"), "Mark window (replaces its marks)")
bind(mod .. " + SHIFT + m", run(bin .. "hypr-mark add"), "Add a mark to the window")
bind(mod .. " + n", run(bin .. "hypr-mark focus"), "Focus a marked window")
bind(mod .. " + ALT + n", run(bin .. "hypr-mark swap"), "Swap with a marked window")
bind(mod .. " + CTRL + m", run(bin .. "hypr-mark move"), "Move window to a marked window's workspace")

-- Submaps (i3's modes). `hyprctl submap` prints the active one ("default" when none);
-- waybar's hyprland/submap module shows it. Passthrough also gets a dunst notice (one
-- stack tag, so leaving replaces entering), as it is mostly used with fullscreen windows,
-- which hide the bar; it times out, as the dunst keys do not reach dunst there. The dunst
-- rule [hyprland-passthrough] shows it over fullscreen windows and while paused.
local submap_notices = {
    passthrough = { title = "Passthrough mode", body = "All keys go to the window; Super+Ctrl+Shift+p leaves", ms = 3000 },
}
local current_notice
hl.on("keybinds.submap", function(name)
    local n = submap_notices[name]
    if not n and not current_notice then return end
    local title, body, ms = (current_notice or "Mode") .. " off", "", 1500
    if n then title, body, ms = n.title, n.body, n.ms end
    current_notice = n and n.title or nil
    -- Fixed texts without single quotes, so plain single-quoting is safe.
    hl.exec_cmd(string.format("notify-send -a hyprland -h string:x-dunst-stack-tag:submap -t %d '%s' '%s'", ms, title, body))
end)
bind(mod .. " + r", hl.dsp.submap("resize"), "Resize mode")
hl.define_submap("resize", function()
    local step = 40
    for _, k in ipairs({
        { keys = { "h", "Left" },  x = -step, y = 0, what = "Narrower" },
        { keys = { "l", "Right" }, x = step,  y = 0, what = "Wider" },
        { keys = { "j", "Down" },  x = 0, y = -step, what = "Shorter" },
        { keys = { "k", "Up" },    x = 0, y = step,  what = "Taller" },
    }) do
        for _, key in ipairs(k.keys) do
            bind(key, hl.dsp.window.resize({ x = k.x, y = k.y, relative = true }), k.what, { repeating = true })
        end
    end
    for _, key in ipairs({ "Return", "Escape", mod .. " + r" }) do
        bind(key, hl.dsp.submap("reset"), "Leave resize mode")
    end
end)
-- Passthrough: every other bind off, for VMs, remote desktops and games (i3's "locked" mode).
bind(mod .. " + CTRL + SHIFT + p", hl.dsp.submap("passthrough"), "Passthrough mode: all keys to the window")
hl.define_submap("passthrough", function()
    bind(mod .. " + CTRL + SHIFT + p", hl.dsp.submap("reset"), "Leave passthrough mode")
end)

----------------------
---- WINDOW RULES ----
----------------------
-- As SwayFX's `inhibit_idle fullscreen`: a fullscreen window holds off the idle chain.
-- Not `idle_inhibit = "fullscreen"`: that also counts maximized windows ($mod+Shift+f;
-- inhibitingIdle in `hyprctl clients -j`), so a maximized terminal would never lock.
hl.window_rule({ name = "idle-inhibit-fullscreen", match = { fullscreen_state_internal = 2 }, idle_inhibit = "always" })
-- Terminal popups from waybar clicks (calcurse, nmtui, bluetoothctl): floating and centred.
hl.window_rule({ name = "bar-popup", match = { class = "bar-popup" }, float = true, size = { 1000, 640 }, center = true })
-- pavucontrol (waybar's volume module, right click): floating, centred, see-through.
hl.window_rule({ name = "pavucontrol", match = { class = "org.pulseaudio.pavucontrol" }, float = true, size = { 1000, 640 }, center = true, opacity = 0.9 })
-- blueman-manager (Bluetooth module, right click) and the meteoblue forecast (weather
-- module, left click; a Chromium --app window, which gets its own class) likewise.
hl.window_rule({ name = "blueman-manager", match = { class = "blueman-manager" }, float = true, size = { 1000, 640 }, center = true, opacity = 0.9 })
hl.window_rule({ name = "weather-forecast", match = { class = "chrome-www.meteoblue.com__.*" }, float = true, size = { 1280, 860 }, center = true, opacity = 0.92 })
{{- end }}
