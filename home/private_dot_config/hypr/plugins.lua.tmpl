{{ if eq (dig "display_server" "x11" .) "wayland" -}}
-- Hyprland plugins per profile (D66), run by hyprland.lua with dofile; returns the profile.
-- List: .chezmoidata/hyprland.yaml (hyprpm.plugins). Built by hyprpm
-- (run_after_hyprpm-plugins.sh.tmpl), never `hyprpm enable`d: plugins load here, with
-- hl.plugin.load, which Hyprland tracks per config (a plugin dropped from the list is
-- unloaded on the next reload). A plugin loads only if its build is for the running
-- Hyprland: line 1 of the installer's stamp is the version it built for, compared with
-- hl.version() (Hyprland itself only checks the plugin API version). Otherwise it is
-- skipped, with one notification per Hyprland version and boot.
local profile = os.getenv("HYPR_PROFILE") or "work" -- ~/.config/uwsm/env-hyprland
local cache = "/var/cache/hyprpm/{{ .chezmoi.username }}/"
local stamp = "{{ joinPath .chezmoi.homeDir ".local" "state" "chezmoi-system" "hyprpm" "built-for" }}"
local plugins = {
{{- range .hyprpm.plugins }}
    { name = {{ .name | quote }}, path = cache .. {{ printf "%s/%s" .repo .file | quote }}, profiles = { {{- range .profiles }} {{ . }} = true,{{ end }} } },
{{- end }}
}

local function first_line(path)
    local f = io.open(path, "r")
    if not f then return nil end
    local line = f:read("*l")
    f:close()
    return line
end

local function exists(path)
    local f = io.open(path, "r")
    if f then f:close() end
    return f ~= nil
end

-- One notification per Hyprland version and boot: the config is evaluated on every reload.
local function warn_once(key, text)
    local marker = (os.getenv("XDG_RUNTIME_DIR") or "/tmp") .. "/hypr-plugins-" .. key
    if exists(marker) then return end
    local f = io.open(marker, "w")
    if f then f:close() end
    hl.exec_cmd("notify-send -a hyprland 'Hyprland plugins skipped' '" .. text .. "'")
end

local running = hl.version()
local built = first_line(stamp)
for _, p in ipairs(plugins) do
    if p.profiles[profile] then
        if built ~= running then
            warn_once("stale-" .. running, "Built for " .. (built or "nothing yet") .. ", running " .. running
                .. ". Run chezmoi apply in a terminal, then hyprctl reload.")
        elseif not exists(p.path) then
            warn_once("missing-" .. p.name, p.path .. " is missing. Run chezmoi apply in a terminal.")
        else
            hl.plugin.load(p.path)
        end
    end
end

return profile
{{ end -}}
