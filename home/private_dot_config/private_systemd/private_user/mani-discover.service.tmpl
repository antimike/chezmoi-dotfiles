{{ if and (lookPath "mani") (lookPath "fd") -}}
[Unit]
Description=Regenerate ~/mani.yaml from the clones on this machine (mani-discover, D35, D72)
Documentation=file://%h/.local/share/chezmoi/home/dot_local/bin/executable_mani-discover.tmpl

[Service]
Type=oneshot
# pproj (pipx, ~/.local/bin) locates the registry (chz-37d). The manager only gets
# ~/.local/bin on PATH from uwsm at login; lingering timers can fire before that.
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=%h/.local/bin/mani-discover
Nice=15
IOSchedulingClass=idle
{{- end }}
