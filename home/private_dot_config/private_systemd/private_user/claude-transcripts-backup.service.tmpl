{{ if lookPath "restic" -}}
[Unit]
Description=Back up Claude transcripts to the backup drives (restic)
Documentation=file://%h/.local/share/chezmoi/home/dot_local/bin/executable_claude-transcripts-backup.tmpl
# Removable drives (.chezmoidata/backups.yaml): silently skip while none is
# mounted ("|" ORs the conditions); Persistent=true on the timer catches up on the
# next trigger after one is mounted. The script skips the unmounted ones.
{{- range .backups.claude_transcripts.drives }}
ConditionPathIsMountPoint=|/run/media/%u/{{ . }}
{{- end }}

[Service]
Type=oneshot
ExecStart=%h/.local/bin/claude-transcripts-backup
Nice=15
IOSchedulingClass=idle
# The restic password from ~/.config/credstore.encrypted/ (D74), decrypted for
# this run only. A missing credential is not an error: the script falls back to
# `pass`, which needs the YubiKey PIN.
ImportCredential=claude-transcripts-backup.*
{{- end }}
