{{ if lookPath "git" -}}
[Unit]
Description=Daily git auto-commit + push for projects with sync.enabled: true in the project registry
Documentation=file://%h/.local/share/chezmoi/home/dot_local/bin/executable_sync-repos.tmpl
# Retry budget: 4 starts per 2 h (the first run plus 3 retries 15 min apart).
StartLimitIntervalSec=2h
StartLimitBurst=4

[Service]
Type=oneshot
# pproj (pipx, ~/.local/bin) locates the registry (chz-37d). The manager only gets
# ~/.local/bin on PATH from uwsm at login; lingering timers can fire before that.
Environment=PATH=%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=%h/.local/bin/sync-repos
Nice=10
# Per-repo deploy keys from sync-repos-deploy-key (D74), decrypted from
# ~/.config/credstore.encrypted/ into $CREDENTIALS_DIRECTORY for this run only.
# A missing key is not an error: that repo falls back to the YubiKey.
ImportCredential=sync-repos.*
# Pushes fail while offline (the timer fires right after resume) or while the
# YubiKey is unplugged; retry instead of waiting for the next day.
Restart=on-failure
RestartSec=15min
{{- end }}
