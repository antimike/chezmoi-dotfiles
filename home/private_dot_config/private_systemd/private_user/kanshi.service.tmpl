{{ if eq (dig "display_server" "x11" .) "wayland" -}}
[Unit]
# Shadows Fedora's /usr/lib/systemd/user/kanshi.service, to tie it to the
# compositor-started helper target instead of graphical-session.target (GNOME).
Description=Output profiles per set of connected screens (kanshi)
Documentation=man:kanshi(1) man:kanshi(5)
PartOf=wm-helpers-wayland.target
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY
# Hyprland lays out outputs with its own monitor rules (~/.config/hypr/hyprland.lua).
ConditionEnvironment=!XDG_CURRENT_DESKTOP=Hyprland

[Service]
# Profiles `exec` helpers in ~/.local/bin (lid-panel-sync).
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin
# NVIDIA renders (docked login, D59): profiles without the panel (~/.config/kanshi/config-nvidia).
ExecStart=/bin/sh -c 'case "$${WLR_DRM_DEVICES:-}" in /dev/dri/dgpu*) exec /usr/bin/kanshi -c %h/.config/kanshi/config-nvidia ;; *) exec /usr/bin/kanshi ;; esac'
ExecReload=/usr/bin/kanshictl reload
Restart=on-failure
RestartSec=2
{{- end }}
