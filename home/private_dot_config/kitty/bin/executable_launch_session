#!/bin/bash
# Launches a named Kitty session

SESSION="$1"

declare -a opts=(
	--session "${HOME}/.config/kitty/sessions/${SESSION}.conf"
	--instance-group "${SESSION^^}"
	--listen-on unix:/tmp/kitty-"$SESSION"
)

# Floating popups close without a confirmation (popup.conf)
case "$SESSION" in
notes)
	opts+=(
		--config "${HOME}/.config/kitty/popup.conf"
		--class floater
		--override background_opacity=0.8
		--override tab_bar_style=hidden
	)
	;;
media)
	opts+=(
		--config "${HOME}/.config/kitty/popup.conf"
		--class dropdown
		--override background_opacity=0.8
	)
	;;
esac

declare -a cmd=("kitty")
if [[ "$2" = "--i3" ]]; then
	shift 2
	cmd=("kitti3" "$@" --)
fi

"${cmd[@]}" "${opts[@]}"
