{{ if eq (dig "display_server" "x11" .) "wayland" -}}
# SwayFX. Body shared with i3: .chezmoitemplates/wm/common; Sway-only lines here.
# Start it from GDM's "SwayFX (uwsm)" entry, not the plain "Sway" one.
# No locker yet (Wayland plan step 4); volume/brightness keys come in step 5.

# Xresources (i3's set_from_resource) is X11-only: use the fallbacks until the
# theming cache exists.
set $fg {{ .i3.colors.fg.default }}
set $bg {{ .i3.colors.bg.default }}
{{- range $c := list "inactive_fg" "inactive_bg" "unfocused_fg" "unfocused_bg" }}
set ${{ $c }} {{ (get $.i3.colors $c).default }}
{{- end }}
# No status bar signal yet (waybar, step 7).
set $refresh_i3status true

{{ includeTemplate "wm/common" (merge (dict "wm" "sway") .) }}
# SwayFX effects
corner_radius {{ .i3.gaps.corner_radius }}

# Exit (under uwsm, `uwsm stop` ends the session cleanly)
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit SwayFX?' -B 'Yes, exit' 'uwsm stop'
bindsym $mod+Shift+Ctrl+e exec uwsm stop

# Outputs, matched by make/model/serial (connector names change with the port:
# the same monitor came up as DP-5 and DP-6). Sway applies these whenever the
# output appears. Laptop panel on the left, bottom edges aligned; the 28" 4K
# monitor at 1.5 is 2560x1440 logical, so the panel sits 360 lower. Static
# positions suit one external monitor; kanshi profiles when there are more.
output "LG Display 0x059E Unknown" pos 0 360
output "Ancor Communications Inc ASUS PB287Q 0x0001EC1B" scale 1.5 pos 1920 0

# Placeholder until waybar (step 7).
bar {
	position top
	status_command while date +'%a %F %H:%M'; do sleep 30; done
}

{{ if lookPath "gnome-keyring-daemon" -}}
# Take over the gnome-keyring daemon that GDM's PAM step started and unlocked with
# the login password (GNOME does this through autostart entries that only run in
# GNOME). Without it the Secret Service is D-Bus-activated later, locked, and
# Chromium or pinentry trigger an unlock prompt.
exec gnome-keyring-daemon --start --components=secrets
{{- end }}

# uwsm: export WAYLAND_DISPLAY/SWAYSOCK and signal readiness, then start the
# shared helpers. Outside uwsm, finalize fails and the helpers stay down.
exec sh -c 'uwsm finalize && systemctl --user start --no-block wm-helpers-wayland.target'

# vim:ft=conf
{{- end }}
