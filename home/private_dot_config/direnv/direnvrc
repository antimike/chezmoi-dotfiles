layout_poetry() {
    # from https://github.com/direnv/direnv/wiki/Python/#poetry
    PYPROJECT_TOML="${PYPROJECT_TOML:-pyproject.toml}"
    if [[ ! -f "$PYPROJECT_TOML" ]]; then
        log_status "No pyproject.toml found. Executing \`poetry init\` to create a \`$PYPROJECT_TOML\` first."
        poetry init
    fi

    if [[ -d ".venv" ]]; then
        VIRTUAL_ENV="$(pwd)/.venv"
    else
        VIRTUAL_ENV=$(poetry env info --path 2>/dev/null ; true)
    fi

    if [[ -z $VIRTUAL_ENV || ! -d $VIRTUAL_ENV ]]; then
        log_status "No virtual environment exists. Executing \`poetry install\` to create one."
        poetry install
        VIRTUAL_ENV=$(poetry env info --path)
    fi

    PATH_add "$VIRTUAL_ENV/bin"
    export POETRY_ACTIVE=1
    export VIRTUAL_ENV
}

layout_pdm() {
    # https://github.com/direnv/direnv/wiki/Python/#PDM
    PYPROJECT_TOML="${PYPROJECT_TOML:-pyproject.toml}"
    if [ ! -f "$PYPROJECT_TOML" ]; then
        log_status "No pyproject.toml found. Executing \`pmd init\` to create a \`$PYPROJECT_TOML\` first."
        pdm init --non-interactive --python "$(python3 --version 2>/dev/null | cut -d' ' -f2 | cut -d. -f1-2)"
    fi

    VIRTUAL_ENV=$(pdm venv list | grep "^\*"  | awk -F" " '{print $3}')


    if [ -z "$VIRTUAL_ENV" ] || [ ! -d "$VIRTUAL_ENV" ]; then
        log_status "No virtual environment exists. Executing \`pdm info\` to create one."
	pdm info
        VIRTUAL_ENV=$(pdm venv list | grep "^\*"  | awk -F" " '{print $3}')
    fi

    PATH_add "$VIRTUAL_ENV/bin"
    export PDM_ACTIVE=1
    export VIRTUAL_ENV
}

layout_uv() {
    # after https://github.com/direnv/direnv/wiki/Python#uv
    # Usage: layout uv [PYTHON]   (PYTHON: a version or interpreter for `uv venv --python`)
    VIRTUAL_ENV="${UV_PROJECT_ENVIRONMENT:-$(pwd)/.venv}"

    if [[ ! -d $VIRTUAL_ENV ]]; then
        if [[ -f pyproject.toml ]]; then
            log_status "No virtual environment exists. Executing \`uv sync\` to create one."
            uv sync ${1:+--python "$1"}
        else
            log_status "No virtual environment exists. Executing \`uv venv\` to create one."
            uv venv ${1:+--python "$1"} "$VIRTUAL_ENV"
        fi
    fi

    PATH_add "$VIRTUAL_ENV/bin"
    export UV_ACTIVE=1
    export VIRTUAL_ENV
}
