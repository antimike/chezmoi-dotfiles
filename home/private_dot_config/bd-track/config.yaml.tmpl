{{- $wsl := .chezmoi.kernel.osrelease | lower | contains "wsl" -}}
# bd-track host settings (managed by chezmoi: edit
# home/private_dot_config/bd-track/config.yaml.tmpl, not this file).
# Schema: bd-track's docs/registry-schema.md, "Host settings". Project settings live in the
# shared registry ~/.config/projects.yaml, not here. `bd-track init-project` rewrites
# idle_stop_hours/check_interval here; `chezmoi apply` puts them back (bd-track ticket filed
# 2026-11-02 to stop that).
global:
  check_interval: daily       # systemd timer cadence for bd-track cleanup
  idle_stop_hours: 4          # 0 disables the idle-stop timer
  # always | never | true | false (not yes/no/on/off). WSL2's network stack stalls pushes.
  dolt_push: {{ if $wsl }}never{{ else }}false{{ end }}
  # Where to find clones of registry projects with a remote but no path; the roots
  # mani-discover scans. Missing directories are skipped. $BD_TRACK_SCAN_ROOTS overrides.
  # Both values come from .chezmoidata/registry.yaml (shared with mani-discover and pproj).
  scan_roots: [{{ .registry.scan_roots | join ", " }}]
  # Clone URL of an owner/repo shorthand remote = this prefix + owner/repo (bd-track >= 0.8.0).
  default_url_prefix: {{ .registry.default_url_prefix | quote }}
  defaults:
    statuses: []
    hooks: []
