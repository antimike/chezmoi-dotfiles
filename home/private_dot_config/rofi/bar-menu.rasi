/* Theme for the bar's menus (networkmanager_dmenu, rofi-bluetooth): the pickers' base theme
   (picker.rasi, colours in colors.rasi) as a narrow list under the bar's right end.
   Use: rofi -theme bar-menu */
@import "picker.rasi"

window {
    location: northeast;
    anchor: northeast;
    x-offset: -8px;
    y-offset: 34px;
    width: 28em;
}
