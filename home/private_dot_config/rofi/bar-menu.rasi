/* Theme for the bar's menus (networkmanager_dmenu, rofi-bluetooth): a narrow list
   under the bar's right end. Blazer colours, as waybar/style.css and hyprlock.conf;
   theming (docs/plans/theming.md) may generate them later. Use: rofi -theme bar-menu */
* {
    bg:         #0d1925eb;
    bg-alt:     #16273a;
    fg:         #d9e5f1;
    fg-dim:     #647384;
    accent:     #7979b8;
    urgent:     #b87979;
    background-color: transparent;
    text-color: @fg;
    font: "Source Code Pro 12";
}

window {
    location: northeast;
    anchor: northeast;
    x-offset: -8px;
    y-offset: 34px;
    width: 28em;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 10px;
    padding: 8px;
}

mainbox { children: [ inputbar, message, listview ]; spacing: 8px; }

inputbar {
    children: [ prompt, entry ];
    spacing: 8px;
    padding: 6px 8px;
    background-color: @bg-alt;
    border-radius: 6px;
}
prompt { text-color: @accent; }
entry { placeholder: "filter"; placeholder-color: @fg-dim; }

message { padding: 4px 8px; }
textbox { text-color: @fg-dim; }

listview { lines: 12; fixed-height: false; scrollbar: false; spacing: 2px; }

element { padding: 5px 8px; border-radius: 6px; }
element normal.normal, element alternate.normal { background-color: transparent; }
element normal.active, element alternate.active { text-color: @accent; }
element normal.urgent, element alternate.urgent { text-color: @urgent; }
element selected.normal { background-color: @accent; text-color: #0d1925; }
element selected.active { background-color: @accent; text-color: #0d1925; }
element selected.urgent { background-color: @urgent; text-color: #0d1925; }
element-text { background-color: inherit; text-color: inherit; }
