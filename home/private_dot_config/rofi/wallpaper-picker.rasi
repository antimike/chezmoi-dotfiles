/* The wallpaper picker (`wallpaper pick`, $mod+w p; chz-1yx): the pickers' base theme
   (picker.rasi, colours in colors.rasi) as a centred grid of thumbnails with each record's
   name under it. Icon size: amontillado's thumbnails are 400 px wide, about 16em at 12pt on a
   scale-1.5 monitor; larger would upscale them (blurry). Use: rofi -theme wallpaper-picker */
@import "picker.rasi"

window { width: 70em; padding: 10px; }
entry { placeholder: "filter by name"; }
message { padding: 2px 8px; }

listview {
    columns: 4;
    lines: 3;
    fixed-columns: true;
    fixed-height: true;
    flow: horizontal;
    spacing: 8px;
}

element { orientation: vertical; padding: 6px; spacing: 4px; border-radius: 8px; }
element-icon { size: 15em; horizontal-align: 0.5; }
element-text { horizontal-align: 0.5; font: "Source Code Pro 9"; }
