/* The pickers' base theme (chz-8bg.9): every rofi picker looks like one family, the bar menus'
   look (MH, 2026-11-20). A centred list; it is rofi's default (config.rasi), so a plain `rofi`
   call gets it. Variants @import this file and change only layout: bar-menu.rasi (under the
   bar), wallpaper-picker.rasi (thumbnail grid). Colours: colors.rasi only (a link to amontillado's
   rofi-colors.rasi in the theme cache, chz-8bg.4); fuzzel's pickers match through ~/.config/fuzzel/fuzzel.ini. */
@import "colors.rasi"

* {
    background-color: transparent;
    text-color: @fg;
    font: "Source Code Pro 12";
}

window {
    location: center;
    anchor: center;
    width: 44em;
    background-color: @bg;
    border: 2px;
    border-color: @accent;
    border-radius: 10px;
    padding: 8px;
}

mainbox { children: [ inputbar, message, listview ]; spacing: 8px; }

inputbar {
    children: [ prompt, entry ];
    spacing: 8px;
    padding: 6px 8px;
    background-color: @bg-alt;
    border-radius: 6px;
}
prompt { text-color: @accent; }
entry { placeholder: "filter"; placeholder-color: @fg-dim; text-color: @fg; }

message { padding: 4px 8px; }
textbox { text-color: @fg-dim; }

listview { lines: 12; fixed-height: false; scrollbar: false; spacing: 2px; }

element { padding: 5px 8px; spacing: 8px; border-radius: 6px; }
/* Every state set, background and text: nothing falls through to rofi's built-in theme.
   "active" rows: the focused window (window switcher), the current connection (network). */
element normal.normal, element alternate.normal { background-color: transparent; text-color: @fg; }
element normal.active, element alternate.active { background-color: transparent; text-color: @accent; }
element normal.urgent, element alternate.urgent { background-color: transparent; text-color: @urgent; }
element selected.normal { background-color: @accent; text-color: @on-accent; }
element selected.active { background-color: @accent; text-color: @on-accent; }
element selected.urgent { background-color: @urgent; text-color: @on-accent; }
element-icon { size: 1.2em; background-color: inherit; }
element-text { background-color: inherit; text-color: inherit; vertical-align: 0.5; }
