/* The pickers' colours, in one place: every picker theme @imports this file and names no
   colour of its own, so a theme change rewrites only this file (rofi reads it at each launch).
   Today: Blazer, as waybar/style.css and hyprlock.conf. From chz-8bg.4, amontillado's theme
   engine renders it from the palette. Keep the variable names: the themes use them.
   Imported by picker.rasi, the base of every picker theme (chz-8bg.9). fuzzel's colours are in
   ~/.config/fuzzel/colors.ini: keep the two in step until amontillado renders both. */
* {
    bg:         #0d1925eb;   /* window, translucent (Hyprland blurs behind rofi) */
    bg-alt:     #16273a;     /* input bar */
    fg:         #d9e5f1;
    fg-dim:     #647384;     /* placeholder, message */
    accent:     #7979b8;     /* border, prompt, selection */
    urgent:     #b87979;
    on-accent:  #0d1925;     /* text on the accent */
}
