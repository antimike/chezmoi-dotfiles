# networkmanager_dmenu (pinned external in ~/.local/bin; .chezmoitemplates/externals.d/bar-pickers.yaml),
# the network menu behind waybar's network module (left click). Options:
# config.ini.example at the pinned commit (github.com/firecat53/networkmanager-dmenu).
# A literal % must be written %% (ConfigParser interpolation).

[dmenu]
dmenu_command = rofi -dmenu -i -theme bar-menu
# Highlight the active connection (rofi) instead of marking it with active_chars.
highlight = True
compact = True
wifi_icons = 󰤯󰤟󰤢󰤥󰤨
format = {icon}  {name:<{max_len_name}}  {sec}
list_saved = False
prompt = Network

[dmenu_passphrase]
# rofi's -password: the typed passphrase shows as dots.
obscure = True

[editor]
# No nm-connection-editor installed, so "Launch connection editor" runs nmtui here.
terminal = kitty --class bar-popup
gui_if_available = True

[nmdm]
rescan_delay = 5
notification_timeout = 5
