# amontillado {{scheme-slug}} ({{scheme-variant}}): fuzzel's picker colours (chz-8bg.4, chz-8bg.9),
# the same roles as rofi-colors.rasi, as RRGGBBAA. ~/.config/fuzzel/colors.ini links here and
# fuzzel.ini includes it; fuzzel reads it at each launch.
[colors]
background={{base00-hex}}eb
text={{base05-hex}}ff
message={{base03-hex}}ff
prompt={{accent-hex}}ff
placeholder={{base03-hex}}ff
input={{base05-hex}}ff
match={{accent-hex}}ff
selection={{accent-hex}}ff
selection-text={{on_accent-hex}}ff
selection-match={{on_accent-hex}}ff
counter={{base03-hex}}ff
border={{accent-hex}}ff
