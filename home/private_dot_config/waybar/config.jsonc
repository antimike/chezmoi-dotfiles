// waybar for Hyprland (daily-driver checklist 2.7; plans/wayland-desktop.md). Run by
// waybar.service from wm-helpers-wayland.target, Hyprland sessions only (SwayFX keeps
// swaybar). Two bars: "main" (the ASUS while docked, the panel undocked; every module
// and the tray) and "extra" (other monitors: workspaces, clock, state indicators).
// Monitors are matched by description (kanshi's names), so ports do not matter.
// Module settings: modules.jsonc. Drawers (group/*) show their first module and
// reveal the rest on hover.
[
    {
        "layer": "top",
        "position": "top",
        "height": 26,
        "spacing": 4,
        "include": [
            "~/.config/waybar/modules.jsonc"
        ],
        "name": "main",
        "output": [
            "Ancor Communications Inc ASUS PB287Q 0x0001EC1B",
            "eDP-1"
        ],
        "modules-left": [
            "hyprland/workspaces",
            "hyprland/submap",
            "hyprland/window"
        ],
        "modules-center": [
            "clock",
            "custom/weather"
        ],
        "modules-right": [
            "custom/idle",
            "custom/dunst",
            "group/system",
            "group/audio",
            "network",
            "bluetooth",
            "battery",
            "tray"
        ]
    },
    {
        "layer": "top",
        "position": "top",
        "height": 26,
        "spacing": 4,
        "include": [
            "~/.config/waybar/modules.jsonc"
        ],
        "name": "extra",
        "output": [
            "!Ancor Communications Inc ASUS PB287Q 0x0001EC1B",
            "!eDP-1",
            "*"
        ],
        "modules-left": [
            "hyprland/workspaces",
            "hyprland/submap",
            "hyprland/window"
        ],
        "modules-center": [
            "clock"
        ],
        "modules-right": [
            "custom/idle",
            "custom/dunst"
        ]
    }
]
