// The main bar: every module and the tray. waybar-launch puts it on the only monitor,
// the left one of two, or the middle one of three or more. Module settings: ../modules.jsonc.
{
    "layer": "top",
    "position": "top",
    "height": 26,
    "spacing": 4,
    "include": [
        "~/.config/waybar/modules.jsonc"
    ],
    "name": "main",
    "modules-left": [
        "hyprland/workspaces",
        "hyprland/submap",
        "hyprland/window"
    ],
    "modules-center": [
        "clock",
        "custom/weather",
        "custom/sunset"
    ],
    "modules-right": [
        "custom/recording",
        "custom/idle",
        "custom/dunst",
        "group/system",
        "group/audio",
        "network",
        "bluetooth",
        "battery",
        "tray"
    ]
}
