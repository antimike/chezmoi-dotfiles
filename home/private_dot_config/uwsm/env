# Sourced by uwsm for every compositor it starts (not by GNOME). POSIX sh.
# See docs/plans/wayland-desktop.md, "GPUs".

# Render on the Intel iGPU; the NVIDIA card stays free for compute. The
# colon-free /dev/dri/igpu symlink comes from the udev rule installed by
# run_onchange_install-udev-dri-symlinks.sh. A monitor on an NVIDIA-wired port
# (DP-4..6 on zbook) needs ":/dev/dri/dgpu" appended.
if [ -e /dev/dri/igpu ]; then
	export WLR_DRM_DEVICES=/dev/dri/igpu # wlroots: SwayFX, Wayfire
	export AQ_DRM_DEVICES=/dev/dri/igpu  # Hyprland (aquamarine)
fi
