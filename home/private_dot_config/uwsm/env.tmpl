# Sourced by uwsm for every compositor it starts (not by GNOME). POSIX sh.
# See docs/plans/wayland-desktop.md, "GPUs".

# Render on the Intel iGPU (D41). The colon-free /dev/dri/igpu and
# /dev/dri/dgpu symlinks come from the udev rule installed by
# run_onchange_install-udev-dri-symlinks.sh. The first device listed renders.
if [ -e /dev/dri/igpu ]; then
	drm_devices=/dev/dri/igpu
{{- if eq .chezmoi.hostname "zbook" }}
	# Every external output on zbook is wired to the NVIDIA card (DP-4..6), so
	# open it too when an external monitor is connected at login (D52); with
	# none, NVIDIA stays asleep. Plugging one in mid-session needs a re-login.
	if [ -e /dev/dri/dgpu ]; then
		dgpu_card=$(basename "$(readlink -f /dev/dri/dgpu)")
		for status in /sys/class/drm/"$dgpu_card"-*/status; do
			if [ "$(cat "$status" 2>/dev/null)" = connected ]; then
{{- if dig "prefer_nvidia_for_external" false . }}
				# NVIDIA renders and drives the monitor directly; the
				# Intel-wired laptop panel gets a copy.
				drm_devices=/dev/dri/dgpu:/dev/dri/igpu
{{- else }}
				# Intel renders; frames for the monitor are copied to NVIDIA.
				drm_devices=/dev/dri/igpu:/dev/dri/dgpu
{{- end }}
				break
			fi
		done
		unset dgpu_card status
	fi
{{- end }}
	export WLR_DRM_DEVICES="$drm_devices" # wlroots: SwayFX, Wayfire
	export AQ_DRM_DEVICES="$drm_devices"  # Hyprland (aquamarine)
	unset drm_devices
fi
