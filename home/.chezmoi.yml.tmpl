{{-
$filesystem := dict
  "cacheDir" ".cache"
  "appData" (joinPath ".local" "share" )
  "sourceDir" "Source"
  "scriptDir" (joinPath ".local" "bin" )
  "tmpDir" "/tmp"
  "venvDir" (joinPath .chezmoi.homeDir ".venv")
  "npmDir" (joinPath .chezmoi.homeDir ".npm-packages")
-}}
{{- $osid := .chezmoi.os -}}
{{- if hasKey .chezmoi.osRelease "id" -}}
{{-   $osid = printf "%s-%s" .chezmoi.os .chezmoi.osRelease.id -}}
{{- end -}}
data:
  osid: {{ $osid | quote }}
  email: "antihaynes@gmail.com"
  gpg:
    keys:
      signing: "9F049F34C91F801DEDF87BBF7C1F6727C99C6EA5"
  filesystem:
{{ $filesystem | toYaml | indent 4 }}
  terminal: kitty
  shell: {{ $zsh := lookPath "zsh" }}{{ if $zsh -}}
    {{ $zsh }}{{ else -}}
    {{ lookPath "sh" }}{{ end }}
  editor: {{ if lookPath "nvim" -}}nvim
    {{- else if lookPath "vim" }}vim
    {{- else }}vi{{ end }}
  enable_systemd_session_services: {{ eq .chezmoi.hostname "voidmobile" }}
  # Hosts with systemd-user lingering (loginctl enable-linger), so user timers
  # fire without an active login session. Distinct from
  # enable_systemd_session_services, which only selects the systemd-managed i3
  # session in ~/.xsession.
  enable_user_lingering: {{ has .chezmoi.hostname (list "zbook") }}
  # zbook only (D52): with an external monitor on an NVIDIA-wired port at login,
  # let NVIDIA render (true) or keep Intel rendering and copy frames over
  # (false). Read as {{ "{{ dig \"prefer_nvidia_for_external\" false . }}" }}. To try
  # the other value without editing: chezmoi apply --override-data
  # '{"prefer_nvidia_for_external":true}' ~/.config/uwsm/env (the next plain
  # apply reverts it).
  # true since D59 (2026-10-23): NVIDIA renders docked sessions (half the sway
  # CPU, hardware cursor); the panel is then unusable (kanshi config-nvidia).
  prefer_nvidia_for_external: true
  # zbook only (D60, 2026-10-23): the GPU that renders Hyprland sessions, docked
  # too: "intel" (NVIDIA stays free for compute; no measured CPU cost) or "nvidia".
  # Read as {{ "{{ dig \"hyprland_render_gpu\" \"intel\" . }}" }} in ~/.config/uwsm/env-hyprland.
  hyprland_render_gpu: intel
  # Desktop-notification client behind ~/.claude/scripts/notify. Under WSL2,
  # D-Bus advertises org.freedesktop.Notifications but no daemon runs, so stock
  # notify-send blocks; use the wsl-notify-send shim there when its chezmoi
  # source is present (stat, not lookPath, so it works before first apply).
  notifier: {{ if (.chezmoi.kernel.osrelease | lower | contains "wsl") -}}
    {{- if stat (joinPath .chezmoi.sourceDir "dot_local/bin/executable_wsl-notify-send.tmpl") -}}
      "wsl-notify-send"
    {{- else -}}
      "notify-send"
    {{- end -}}
  {{- else -}}
    "notify-send"
  {{- end }}
  # Display server of the graphical session: "wayland", "x11" or "none" (no
  # graphical session, e.g. over ssh). Detected once, when `chezmoi init`
  # generates this config, from the session environment (XDG_SESSION_TYPE, then
  # WAYLAND_DISPLAY and DISPLAY, since XWayland sets DISPLAY inside a Wayland
  # session). Templates read it as `dig "display_server" "x11" .` so a config
  # generated before this key existed still renders. Re-run `chezmoi init` from
  # the session you use, or edit the generated config, to change it. It selects
  # builds and tools; it does not say whether the compositor supports the
  # clipboard-history protocol (GNOME's does not, Sway's does).
  display_server: {{ if eq (env "XDG_SESSION_TYPE") "wayland" -}}
    "wayland"
  {{- else if eq (env "XDG_SESSION_TYPE") "x11" -}}
    "x11"
  {{- else if env "WAYLAND_DISPLAY" -}}
    "wayland"
  {{- else if env "DISPLAY" -}}
    "x11"
  {{- else -}}
    "none"
  {{- end }}
  # Gates employer-only tooling (VPN stack, rano). False here; true on a future
  # work laptop. Use as {{ "{{ if .work_tooling }}" }} inline guards.
  work_tooling: false
  # Package targets to install (packages.yaml, packageTargets; D32). A target's
  # `when` conditions still apply, so `wayland` is skipped on non-Wayland hosts.
  package_targets:
    - base
    - wayland
  wallpaper:
    cache: {{ joinPath $filesystem.cacheDir "wallpaper" "current-wallpaper.png" }}
    library: {{ joinPath $filesystem.appData "wallpaper" }}
  externals:
{{ range $tmpl :=
  joinPath .chezmoi.sourceDir ".chezmoitemplates" "externals.d" 
    "*.{yml,yaml}" 
  | glob
-}}
{{- includeTemplate $tmpl $filesystem | indent 4 }}
{{ end -}}
