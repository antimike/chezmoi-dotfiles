#!/usr/bin/env bash
# annex-gcrypt-test — rehearse `annex-gcrypt` (chz-iqp) end to end in a throwaway HOME.
#
#   tools/annex-gcrypt-test/annex-gcrypt-test [-v]
#
# Three "machines" are three GNUPGHOMEs with Curve25519 keys (zbook, laptop, an offline
# backup key) plus a non-participant key standing in for the YubiKey signing key; a bare
# repository stands in for GitHub (gcrypt's git backend, as GitHub gets) and a directory
# for the SSD special remote. Runs the source copy (home/dot_local/bin/). Covers: init,
# a clone refused without public keys / without being a participant, add-key, clone +
# setup on the new machine, sync both ways (participants re-applied from the pulled
# .annex-gcrypt), a global user.signingkey outside the participants, check catching a
# broken clone and sync refusing to push, the drive not mounted, the backup key alone
# restoring, remove-key. One line per case; exits 1 if any fails. -v shows command output.
# Needs git, git-annex, git-remote-gcrypt, gpg. Takes about a minute.
set -euo pipefail

repo=$(cd "$(dirname "$0")/../.." && pwd)
helper=$repo/home/dot_local/bin/executable_annex-gcrypt
verbose=0
[[ ${1:-} == -v ]] && verbose=1

T=$(mktemp -d)
# shellcheck disable=SC2329 # run by the EXIT trap
cleanup() {
  local g
  for g in "$T"/gpg-*; do GNUPGHOME=$g gpgconf --kill all >/dev/null 2>&1 || true; done
  chmod -R u+w "$T" 2>/dev/null || true # git-annex objects are read-only
  rm -rf "$T"
}
trap cleanup EXIT
export HOME=$T/home GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0
mkdir -p "$HOME" "$T/bin"
ln -s "$helper" "$T/bin/annex-gcrypt"
export PATH=$T/bin:$PATH
git config --global user.name test
git config --global user.email test@example.invalid
git config --global init.defaultBranch main
git config --global commit.gpgsign false
git config --global annex.autocommit true

failed=0
ok() { echo "ok   $1"; }
bad() { echo "FAIL $1"; failed=1; }
run() { # run a command, output shown with -v; returns its status
  if ((verbose)); then "$@"; else "$@" >"$T/out" 2>&1; fi
}
expect() { # expect NAME CMD...: CMD succeeds
  local name=$1; shift
  if run "$@"; then ok "$name"; else bad "$name"; ((verbose)) || sed 's/^/     /' "$T/out" | tail -5; fi
}
expect_fail() { # expect_fail NAME PATTERN CMD...: CMD fails and its output matches PATTERN
  local name=$1 pat=$2; shift 2
  if "$@" >"$T/out" 2>&1; then bad "$name (succeeded)"; return; fi
  if grep -qE "$pat" "$T/out"; then ok "$name"; else bad "$name (output: $(tail -1 "$T/out"))"; fi
}

newkey() { # newkey NAME -> fingerprint; keyring $T/gpg-NAME
  mkdir -p "$T/gpg-$1" && chmod 700 "$T/gpg-$1"
  GNUPGHOME=$T/gpg-$1 gpg -q --batch --passphrase '' --quick-gen-key "$1 <$1@example.invalid>" default default never >/dev/null 2>&1
  GNUPGHOME=$T/gpg-$1 gpg --batch --list-keys --with-colons 2>/dev/null | awk -F: '/^fpr/ {print $10; exit}'
}
import() { # import INTO FROM...: FROM's public keys into INTO's keyring
  local into=$1 from; shift
  for from in "$@"; do
    GNUPGHOME=$T/gpg-$from gpg --batch --export | GNUPGHOME=$T/gpg-$into gpg -q --batch --import >/dev/null 2>&1
  done
}
on() { local m=$1; shift; GNUPGHOME=$T/gpg-$m "$@"; } # on MACHINE CMD...
check() { # check NAME TEST...: TEST (a command) succeeds, quietly
  local name=$1; shift
  if "$@" >/dev/null 2>&1; then ok "$name"; else bad "$name"; fi
}

KZ=$(newkey zbook); KL=$(newkey laptop); KO=$(newkey offline)
KY=$(GNUPGHOME=$T/gpg-zbook gpg -q --batch --passphrase '' --quick-gen-key "yubi <y@example.invalid>" default default never >/dev/null 2>&1
  GNUPGHOME=$T/gpg-zbook gpg --batch --list-keys --with-colons yubi 2>/dev/null | awk -F: '/^fpr/ {print $10; exit}')
import zbook offline laptop

URL=gcrypt::$T/github.git
git init -q --bare "$T/github.git"
SSD=$T/ssd

record() { # record DIR NAME: an amontillado-like record
  mkdir -p "$1/$2/.amo"
  head -c 30000 /dev/urandom >"$1/$2/$2.jpg"
  head -c 2000 /dev/urandom >"$1/$2/.amo/thumbnail.jpg"
  printf 'schema: 2\nname: %s\n' "$2" >"$1/$2/info.yaml"
}

# --- zbook creates the library
L=$T/zbook/lib
mkdir -p "$L" && cd "$L" && git init -q
printf '* annex.largefiles=nothing\n*.jpg annex.largefiles=anything\n**/.amo/** annex.largefiles=nothing\ninfo.yaml merge=amo-info\n' >.gitattributes
record "$L" first
on zbook git annex init -q zbook
on zbook git annex add -q . && git commit -qm first
expect "init: both remotes, encrypted to zbook + offline" \
  on zbook annex-gcrypt init --url "$URL" --directory "$SSD" "$KZ" "$KO"
expect "init: special remote holds the image" \
  bash -c "git annex whereis first/first.jpg 2>/dev/null | grep -q '\[ssd\]'"
expect "init: check passes" on zbook annex-gcrypt check
check "init: signing key is zbook's" test "$(git config remote.github.gcrypt-signingkey)" = "$KZ"
if grep -rqs 'schema: 2' "$T/github.git" "$SSD"; then bad "no plaintext info files off-machine"; else ok "no plaintext info files off-machine"; fi

# --- laptop: refused before it has the public keys, and before it is a participant
expect_fail "clone without public keys is refused" 'No public key|import every' \
  on laptop annex-gcrypt clone "$URL" "$T/laptop/lib0" --directory "$SSD"
import laptop zbook offline
expect_fail "clone by a non-participant is refused" 'Failed to decrypt|not a participant' \
  on laptop annex-gcrypt clone "$URL" "$T/laptop/lib1" --directory "$SSD"

# --- zbook adds the laptop's key
expect "add-key laptop (from zbook)" on zbook annex-gcrypt add-key "$KL"
expect "add-key: special remote encrypted to laptop" \
  bash -c "git annex info ssd 2>/dev/null | grep -q '${KL: -16}'"

# --- laptop clones and restores
rm -rf "$T/laptop"
expect "clone + setup on laptop" on laptop annex-gcrypt clone "$URL" "$T/laptop/lib" --directory "$SSD"
LB=$T/laptop/lib
cd "$LB"
expect "laptop: git annex get restores the image" on laptop git annex get -q first/first.jpg
check "laptop: content identical" cmp "$LB/first/first.jpg" "$L/first/first.jpg"
check "laptop: amo-info merge driver set" test "$(git config merge.amo-info.driver)" = 'amo info merge %O %A %B --name %P'
check "laptop: clone remote renamed to github" test "$(git remote | grep -v '^ssd$' | tr '\n' ' ')" = "github "

# --- sync both ways, with a global YubiKey-like signing key on both machines
git config --global user.signingkey "$KY"
record "$LB" second
on laptop git annex add -q second && git commit -qm second
expect "laptop sync (global signingkey not a participant)" on laptop annex-gcrypt sync
cd "$L"
expect "zbook sync pulls laptop's record" on zbook annex-gcrypt sync
expect "zbook gets laptop's image from the drive" on zbook git annex get -q second/second.jpg
git config --global --unset user.signingkey

# --- participants change on one machine reach the other through sync
cd "$LB"
git config remote.github.gcrypt-participants "$KL" # stale/broken clone config
expect_fail "check catches a wrong participants list" 'differs' on laptop annex-gcrypt check
cd "$L"
echo "tags: [x]" >>first/info.yaml && git commit -qam edit
expect "zbook sync" on zbook annex-gcrypt sync
cd "$LB"
expect "laptop sync repairs participants from .annex-gcrypt" on laptop annex-gcrypt sync
check "laptop: participants are the committed list" test "$(git config remote.github.gcrypt-participants)" = "$KZ $KO $KL"
cd "$L"
expect "zbook still reads the remote after laptop's push" on zbook git fetch -q github

# --- sync refuses to push from a clone that check rejects
git config remote.github.gcrypt-publish-participants false
git config --unset remote.github.gcrypt-signingkey
expect_fail "sync refuses to push from an unset-up clone" 'not set up|not pushing' on zbook annex-gcrypt sync
expect "setup repairs it" on zbook annex-gcrypt setup

# --- drive not mounted: content skipped, git still pushed
mv "$SSD" "$SSD.away"
record "$L" third
on zbook git annex add -q third && git commit -qm third
if on zbook annex-gcrypt sync >"$T/out" 2>&1 && grep -q 'not mounted' "$T/out"; then
  ok "sync with the drive away: pushes git, skips content"
else bad "sync with the drive away: pushes git, skips content"; fi
mv "$SSD.away" "$SSD"
expect "sync with the drive back copies the content" on zbook annex-gcrypt sync

# --- the offline backup key alone restores everything
import offline zbook laptop
expect "offline key: clone + setup" on offline annex-gcrypt clone "$URL" "$T/offline/lib" --directory "$SSD"
cd "$T/offline/lib"
expect "offline key: get every image" on offline git annex get -q .
check "offline key: content identical" cmp third/third.jpg "$L/third/third.jpg"

# --- remove-key: the laptop no longer reads what comes later
cd "$L"
expect "remove-key laptop" on zbook annex-gcrypt remove-key "$KL"
cd "$LB"
expect_fail "laptop can no longer fetch" 'Failed to decrypt|decrypt' on laptop git fetch github
cd "$L"
expect "zbook still reads the remote" on zbook git fetch -q github

exit "$failed"
