#!/usr/bin/env bash
# bufferbloat-check — latency under load: ping while idle, while saturating the download, while saturating the upload.
#
#   bufferbloat-check                       all three phases, 30 s each
#   bufferbloat-check --duration 60         longer phases
#   bufferbloat-check --phases idle,up      a subset (idle, down, up)
#   bufferbloat-check --streams 4           parallel transfers per loaded phase (default 2)
#   bufferbloat-check --target 9.9.9.9      ping target (default 1.1.1.1)
#
# Prints a Markdown table (docs/runbooks/home-network.md, "Video calls and bufferbloat"): ping to the target at 5/s
# (avg, max, jitter = mdev, loss), ping to the default gateway (the router hop: if it stays low while the target
# climbs, the queue is beyond the router), and the throughput reached, read from the default-route interface's byte
# counters. Load comes from Cloudflare's speed endpoints (downloads are capped at 25 MB a request, so each stream
# loops). Moves a few hundred MB per run; nothing else is changed.
set -euo pipefail

usage() { echo "usage: bufferbloat-check [--duration S] [--phases idle,down,up] [--streams N] [--target HOST]" >&2; exit 2; }

duration=30
phases=idle,down,up
streams=2
target=1.1.1.1
while (($#)); do
  case $1 in
    --duration) (($# >= 2)) || usage; duration=$2; shift 2 ;;
    --phases) (($# >= 2)) || usage; phases=$2; shift 2 ;;
    --streams) (($# >= 2)) || usage; streams=$2; shift 2 ;;
    --target) (($# >= 2)) || usage; target=$2; shift 2 ;;
    -h | --help) sed -n '2,/^set /p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    *) usage ;;
  esac
done

read -r gateway dev < <(ip -4 route show default | awk '{print $3, $5; exit}')
[[ -n ${dev:-} ]] || { echo "no default route" >&2; exit 1; }

DOWN_URL='https://speed.cloudflare.com/__down?bytes=25000000'
UP_URL='https://speed.cloudflare.com/__up'

tmp=$(mktemp -d)
loaders=()
stop_loaders() {
  if ((${#loaders[@]})); then
    kill -- "${loaders[@]/#/-}" 2>/dev/null || true # negative pids: each loop's whole process group
    wait "${loaders[@]}" 2>/dev/null || true
  fi
  loaders=()
}
trap 'stop_loaders; rm -rf "$tmp"' EXIT

# One load stream: repeat the transfer until killed. setsid gives each loop its own process group, so the kill
# above ends the curl in flight too.
start_loader() {
  case $1 in
    down) setsid bash -c "while :; do curl -s -o /dev/null '$DOWN_URL'; done" & ;;
    up) setsid bash -c "while :; do head -c 100000000 /dev/zero | curl -s -o /dev/null -X POST --data-binary @- '$UP_URL'; done" & ;;
  esac
  loaders+=("$!")
}

# "avg max mdev loss%" from ping's summary lines.
ping_stats() {
  awk -F'[ /,]+' '
    /packet loss/ { for (i = 1; i <= NF; i++) if ($i ~ /%$/) loss = $i }
    /^rtt|^round-trip/ { avg = $8; max = $9; mdev = $10 }
    END { printf "%s %s %s %s\n", (avg == "" ? "-" : avg), (max == "" ? "-" : max), (mdev == "" ? "-" : mdev), loss }
  ' "$1"
}

counter() { cat "/sys/class/net/$dev/statistics/$1_bytes"; }

echo "interface $dev, gateway $gateway, target $target, ${duration} s per phase, $streams streams"
echo
echo "| Load | Avg | Max | Jitter (mdev) | Loss | Gateway avg | Throughput |"
echo "|---|---|---|---|---|---|---|"

IFS=, read -ra phase_list <<<"$phases"
for phase in "${phase_list[@]}"; do
  case $phase in
    idle) label="Idle"; counter_dir=rx ;;
    down) label="Download saturated"; counter_dir=rx ;;
    up) label="Upload saturated"; counter_dir=tx ;;
    *) echo "unknown phase: $phase" >&2; exit 2 ;;
  esac
  if [[ $phase != idle ]]; then
    for ((i = 0; i < streams; i++)); do start_loader "$phase"; done
    sleep 3 # let TCP ramp up before measuring
  fi
  bytes_before=$(counter "$counter_dir")
  ping -q -i 0.2 -w "$duration" "$target" >"$tmp/target" 2>&1 &
  ping_target=$!
  ping -q -i 0.2 -w "$duration" "$gateway" >"$tmp/gateway" 2>&1 &
  ping_gateway=$!
  wait "$ping_target" "$ping_gateway" || true # ping exits 1 on loss; the stats are still printed
  bytes_after=$(counter "$counter_dir")
  stop_loaders

  read -r avg max mdev loss < <(ping_stats "$tmp/target")
  read -r gw_avg _ _ _ < <(ping_stats "$tmp/gateway")
  mbit=$(awk -v b=$((bytes_after - bytes_before)) -v d="$duration" 'BEGIN { printf "%.1f", b * 8 / d / 1e6 }')
  printf '| %s | %s ms | %s ms | %s ms | %s | %s ms | %s Mbit/s %s |\n' \
    "$label" "$avg" "$max" "$mdev" "$loss" "$gw_avg" "$mbit" "$counter_dir"
done
