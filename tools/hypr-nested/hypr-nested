#!/usr/bin/env bash
# hypr-nested — a throwaway Hyprland nested in the running Hyprland session, in a
# resource-limited systemd scope, for testing plugins and configs without risking
# the session (e.g. a hyprpm plugin after a Hyprland update).
#
#   tools/hypr-nested/hypr-nested start --workspace WS [--config FILE] [--env VAR=VALUE]...
#   tools/hypr-nested/hypr-nested ctl HYPRCTL-ARGS...   # hyprctl, aimed at the nested instance
#   tools/hypr-nested/hypr-nested sig                   # its instance signature
#   tools/hypr-nested/hypr-nested log                   # its stdout/stderr
#   tools/hypr-nested/hypr-nested stop
#
# start: opens the nested Hyprland as a window on workspace WS of the session,
# silently (focus stays where it is), so it can be kept off a monitor in use: pick a
# workspace on another monitor (`hyprctl workspaces`). Required on purpose. --env sets
# a variable for the nested Hyprland (e.g. HYPR_PROFILE=riced, D66); repeatable.
# The scope (hypr-nested.scope) caps memory at 2G with no swap, 2 CPUs at low
# weight, low IO weight and 256 tasks; `stop` kills it all. It renders on the session's
# GPU: aquamarine's Wayland backend opens the parent's dmabuf main device and ignores
# AQ_DRM_DEVICES (read only by the DRM backend), so GPU costs measured here are the
# session's GPU's (Intel under D60). A GPU hang is the one thing the scope cannot
# contain (i915 resets a hung context per client). Default config: no autostart (no uwsm,
# helpers or hyprpm), no XWayland, dwindle; written to the state dir. Drive it with
# `ctl`, e.g. `ctl plugin load /var/cache/hyprpm/$USER/hy3/hy3.so`,
# `ctl dispatch 'hl.dsp.exec_cmd("kitty")'`. `ctl` always passes `-i`, so it can
# never reach the session's own instance.
# State: $XDG_RUNTIME_DIR/hypr-nested/ (sig, log, nested.lua).
set -euo pipefail

unit=hypr-nested
dir=${XDG_RUNTIME_DIR:?}/hypr-nested
usage() { sed -n '2,/^set -euo/{/^set -euo/d;s/^# \{0,1\}//;p}' "$0"; }
die() { echo "hypr-nested: $*" >&2; exit 1; }

sig() {
  [ -s "$dir/sig" ] || die "not running (no $dir/sig)"
  cat "$dir/sig"
}

default_config() {
  cat <<'EOF'
-- hypr-nested default config: nothing starts, nothing reaches the parent session.
hl.config({
    general    = { layout = "dwindle", gaps_in = 2, gaps_out = 4, border_size = 2 },
    animations = { enabled = false },
    misc       = { disable_hyprland_logo = true, force_default_wallpaper = 0 },
    xwayland   = { enabled = false },
})
EOF
}

start() {
  local ws='' config='' envs=''
  while [ $# -gt 0 ]; do
    case $1 in
      --workspace) ws=${2:?--workspace needs a value}; shift 2 ;;
      --config)    config=${2:?--config needs a file}; shift 2 ;;
      --env)       [[ ${2:-} =~ ^[A-Za-z_][A-Za-z0-9_]*=[A-Za-z0-9_./:-]*$ ]] || die "--env needs VAR=VALUE (plain characters)"
                   envs+=" $2"; shift 2 ;;
      *) die "unknown option: $1" ;;
    esac
  done
  [ -n "$ws" ] || die "start needs --workspace (one on a monitor you are not using)"
  [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] || die "not in a Hyprland session"
  systemctl --user is-active --quiet "$unit.scope" && die "already running ($unit.scope); stop it first"
  mkdir -p "$dir"
  rm -f "$dir/sig"
  if [ -n "$config" ]; then
    cp "$config" "$dir/nested.lua"
  else
    default_config >"$dir/nested.lua"
  fi
  hyprctl instances -j | jq -r '.[].instance' | sort >"$dir/before"

  local cmd
  cmd="systemd-run --user --scope --unit=$unit --quiet"
  cmd+=" -p MemoryMax=2G -p MemorySwapMax=0 -p TasksMax=256"
  cmd+=" -p CPUQuota=200% -p CPUWeight=20 -p IOWeight=20"
  cmd+=" env -u HYPRLAND_INSTANCE_SIGNATURE$envs"
  cmd+=" Hyprland -c $dir/nested.lua >$dir/log 2>&1"
  # The parent's exec rule places the window; Lua dispatch syntax (0.56 Lua config).
  hyprctl dispatch "hl.dsp.exec_cmd(\"sh -c '$cmd'\", { workspace = \"$ws silent\" })" >/dev/null

  local _ new
  for _ in $(seq 50); do
    sleep 0.2
    new=$(hyprctl instances -j | jq -r '.[].instance' | sort | comm -13 "$dir/before" -)
    if [ -n "$new" ]; then
      printf '%s\n' "$new" | head -n 1 >"$dir/sig"
      echo "hypr-nested: running on workspace $ws, instance $(cat "$dir/sig")"
      return 0
    fi
    systemctl --user is-active --quiet "$unit.scope" || break
  done
  echo "hypr-nested: no nested instance appeared; log:" >&2
  tail -n 20 "$dir/log" >&2 || true
  systemctl --user stop "$unit.scope" 2>/dev/null || true
  exit 1
}

case ${1:-} in
  start) shift; start "$@" ;;
  ctl)   shift; s=$(sig); exec hyprctl -i "$s" "$@" ;;
  sig)   sig ;;
  log)   cat "$dir/log" ;;
  stop)  systemctl --user stop "$unit.scope" 2>/dev/null || echo "hypr-nested: not running" >&2
         rm -f "$dir/sig" ;;
  -h|--help|"") usage ;;
  *) die "unknown command: $1 (try --help)" ;;
esac
