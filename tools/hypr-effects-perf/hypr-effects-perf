#!/usr/bin/env bash
# hypr-effects-perf — GPU and CPU cost of Hyprland's effects, one row per effect setting,
# in the running session (the riced-profile GPU decision; docs/plans/ricing-backlog.md).
#
#   tools/hypr-effects-perf/hypr-effects-perf run LABEL [--phase SECONDS] [--only SETTING,...]
#   tools/hypr-effects-perf/hypr-effects-perf results
#
# run: on the focused monitor, opens a test scene on workspaces 98 and 99 (a kitty scrolling
# text at 20 Hz behind a floating kitty, a second tiled kitty, one on 99), then for each
# setting applies it live (`hyprctl eval`) and measures two phases of SECONDS (default 15):
#   scroll  only the background text changes (blur behind the floating window redraws)
#   churn   workspace switches every 0.5 s, focus changes, a kitty opened/closed every 2 s
# Settings: off, blur, shadow, anim, opacity, all, all-xray (all with blur xray on).
# "off" turns every effect off; the others add one effect to it. kitty's own background
# opacity (0.9) stays, so blur always has something to do. Hands off the keyboard and
# mouse while it runs (a notification says when); about 4 minutes at the default.
# Afterwards: `hyprctl reload` (the config's own effects again), the test windows closed
# (by PID) and the previous workspace focused; also on Ctrl+C.
#
# Per phase: Hyprland CPU % (of one core, from /proc), Intel GPU busy % (1 - RC6
# residency; i915 sysfs, no root) and its average clock, NVIDIA utilisation % and power
# (nvidia-smi, 1 s samples). Whole-GPU numbers: keep other apps quiet (no video, a busy
# Claude Code spinner). Rows go to $HYPR_EFFECTS_PERF_DIR (default
# ~/.local/state/hypr-effects-perf/results.tsv) with the label, the GPU order
# (AQ_DRM_DEVICES) and HYPR_PROFILE.
set -euo pipefail

usage() { echo "usage: hypr-effects-perf run LABEL [--phase SECONDS] [--only SETTING,...] | results" >&2; exit 2; }

dir=${HYPR_EFFECTS_PERF_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/hypr-effects-perf}
results=$dir/results.tsv
all_settings=(off blur shadow anim opacity all all-xray)

case ${1:-} in
  results) [[ -s $results ]] && column -t -s $'\t' "$results"; exit 0 ;;
  run) label=${2:-}; [[ -n $label && $label != -* ]] || usage; shift 2 ;;
  *) usage ;;
esac
phase=15
settings=("${all_settings[@]}")
while (($#)); do
  case $1 in
    --phase) phase=${2:-}; [[ $phase =~ ^[0-9]+$ ]] || usage; shift 2 ;;
    --only) IFS=, read -r -a settings <<<"${2:-}"; shift 2 ;;
    *) usage ;;
  esac
done
for s in "${settings[@]}"; do [[ " ${all_settings[*]} " == *" $s "* ]] || { echo "unknown setting: $s" >&2; usage; }; done
[[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]] || { echo "not in a Hyprland session" >&2; exit 1; }

hpid=$(pgrep -o -x Hyprland)
igpu=/sys/class/drm/$(basename "$(readlink -f /dev/dri/igpu 2>/dev/null || echo card1)")/gt/gt0
[[ -r $igpu/rc6_residency_ms ]] || { echo "no i915 RC6 counters at $igpu" >&2; exit 1; }
clk=$(getconf CLK_TCK)
tmp=$(mktemp -d)
mkdir -p "$dir"
[[ -s $results ]] || printf 'date\tlabel\tgpu_order\tprofile\tsetting\tphase\thypr_cpu%%\tigpu_busy%%\tigpu_mhz\tnv_util%%\tnv_w\n' >"$results"

# hyprctl answers "ok" or an error text (exit status 0 either way).
ipc() {
  local out
  out=$(hyprctl "$@")
  [[ $out == ok ]] || { echo "hyprctl $1: $out" >&2; return 1; }
}
d() { ipc dispatch "$1"; }
ev() { ipc eval "$1"; }
spawn() { # CLASS RULES CMD...
  local class=$1 rules=$2
  shift 2
  d "hl.dsp.exec_cmd([[kitty --class $class $*]], { $rules })" # Lua long string: no escaping
}
pids_of() { hyprctl clients -j | jq -r --arg c "$1" '.[] | select(.class | startswith($c)) | .pid'; }

# The effect settings, as Lua for hyprctl eval. Each starts from everything off.
lua_off='hl.config({ decoration = { inactive_opacity = 1.0, shadow = { enabled = false }, blur = { enabled = false, xray = false } }, animations = { enabled = false } })'
lua_for() {
  case $1 in
    off) echo "$lua_off" ;;
    blur) echo "$lua_off hl.config({ decoration = { blur = { enabled = true } } })" ;;
    shadow) echo "$lua_off hl.config({ decoration = { shadow = { enabled = true } } })" ;;
    anim) echo "$lua_off hl.config({ animations = { enabled = true } })" ;;
    opacity) echo "$lua_off hl.config({ decoration = { inactive_opacity = 0.92 } })" ;;
    all) echo 'hl.config({ decoration = { inactive_opacity = 0.92, shadow = { enabled = true }, blur = { enabled = true, xray = false } }, animations = { enabled = true } })' ;;
    all-xray) echo 'hl.config({ decoration = { inactive_opacity = 0.92, shadow = { enabled = true }, blur = { enabled = true, xray = true } }, animations = { enabled = true } })' ;;
  esac
}

prev_ws=$(hyprctl activeworkspace -j | jq -r .id)
cleanup() {
  [[ -n ${churn_pid:-} ]] && kill "$churn_pid" 2>/dev/null
  pids_of perf- | xargs -r kill 2>/dev/null || true
  hyprctl reload >/dev/null || true
  d "hl.dsp.focus({ workspace = $prev_ws })" || true
  rm -rf "$tmp"
}
trap cleanup EXIT
trap 'exit 130' INT TERM

# The scene. The scroller fills its window with new text 20 times a second.
# shellcheck disable=SC2016 # expanded by the inner sh
scroller='sh -c "while sleep 0.05; do date +%T.%N; seq -s \" \" \$RANDOM \$((RANDOM + 40)); done"'
d 'hl.dsp.focus({ workspace = 98 })'
spawn perf-bg 'workspace = "98 silent"' "$scroller"
spawn perf-b 'workspace = "98 silent"'
sleep 1
spawn perf-float 'workspace = "98 silent", float = true, size = "1100 650", center = true' "$scroller"
spawn perf-c 'workspace = "99 silent"'
sleep 2

# Churn: workspace switches, focus cycling, a window opened and one closed.
churn() {
  local i=0 last=""
  while :; do
    # Errors here (e.g. no window to the right) must not end the loop.
    d "hl.dsp.focus({ workspace = $((i % 2 ? 99 : 98)) })" || true
    ((i % 2)) || d 'hl.dsp.focus({ direction = "right" })' || true
    if ((i % 4 == 0)); then
      [[ -z $last ]] || kill "$last" 2>/dev/null || true
      spawn perf-churn 'workspace = "98 silent"' || true
      sleep 0.3
      last=$(pids_of perf-churn | tail -1)
    fi
    i=$((i + 1))
    sleep 0.5
  done
}

# Measure SECONDS; prints "cpu% busy% mhz nv_util% nv_w".
measure() {
  local s=$1 t0 t1 r0 r1 c0 c1
  nvidia-smi --query-gpu=utilization.gpu,power.draw --format=csv,noheader,nounits -l 1 >"$tmp/nv" 2>/dev/null &
  local nvp=$!
  (while :; do cat "$igpu/rps_act_freq_mhz"; sleep 0.5; done) >"$tmp/mhz" &
  local fp=$!
  t0=$(date +%s%3N) r0=$(<"$igpu/rc6_residency_ms")
  c0=$(awk '{print $14 + $15}' "/proc/$hpid/stat")
  sleep "$s"
  t1=$(date +%s%3N) r1=$(<"$igpu/rc6_residency_ms")
  c1=$(awk '{print $14 + $15}' "/proc/$hpid/stat")
  kill "$nvp" "$fp" 2>/dev/null
  wait "$nvp" "$fp" 2>/dev/null || true
  local dt=$((t1 - t0))
  awk -v c="$((c1 - c0))" -v clk="$clk" -v dt="$dt" -v rc6="$((r1 - r0))" \
    -v mhz="$(awk '{s += $1; n++} END {printf "%.0f", n ? s / n : 0}' "$tmp/mhz")" \
    -v nv="$(awk -F', *' '{u += $1; w += $2; n++} END {printf "%.0f %.1f", n ? u / n : 0, n ? w / n : 0}' "$tmp/nv")" \
    'BEGIN { b = 100 * (1 - rc6 / dt); if (b < 0) b = 0
             printf "%.1f %.0f %s %s\n", 100 * c / clk / (dt / 1000), b, mhz, nv }'
}

gpu_order=${AQ_DRM_DEVICES:-unset}
notify-send -a hypr-effects-perf "Hands off" "Measuring ${#settings[@]} settings, about $(((${#settings[@]} * phase * 2 + ${#settings[@]} * 3) / 60 + 1)) min"
for s in "${settings[@]}"; do
  ev "$(lua_for "$s")"
  d 'hl.dsp.focus({ workspace = 98 })'
  sleep 3
  for p in scroll churn; do
    [[ $p == churn ]] && { churn & churn_pid=$!; }
    read -r cpu busy mhz nvu nvw <<<"$(measure "$phase")"
    [[ $p == churn ]] && { kill "$churn_pid"; wait "$churn_pid" 2>/dev/null || true; churn_pid=""; }
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$(date +%FT%T)" "$label" "$gpu_order" "${HYPR_PROFILE:-}" \
      "$s" "$p" "$cpu" "$busy" "$mhz" "$nvu" "$nvw" | tee -a "$results"
  done
  pids_of perf-churn | xargs -r kill 2>/dev/null || true
done
notify-send -a hypr-effects-perf "Done" "Results: tools/hypr-effects-perf/hypr-effects-perf results"
