test5_two_hosts() {
    local id r1 r2 g1 g2 s1=ok s2=ok s3=ok
    case $TOOL in
        kata)
            kata_init_repo h1 "$T/hosts/h1/src/alpha"; r1=$T/hosts/h1/src/alpha
            id=$(in_repo h1 "$r1" kata_create "shared issue")
            setup_private_plain h1; kata_sync h1 || s1=fail
            setup_private_plain h2; mkdir -p "$T/hosts/h2/kata"; cp "$T/hosts/h2/private/kata.db" "$T/hosts/h2/kata/"
            r2=$T/hosts/h2/src/alpha; kata_init_repo h2 "$r2" 2>/dev/null || true
            in_repo h1 "$r1" kata_title "$id" "title from h1"; in_repo h1 "$r1" kata_label "$id" from-h1
            in_repo h2 "$r2" kata_title "$id" "title from h2"; in_repo h2 "$r2" kata_label "$id" from-h2
            kata_sync h1 || s2=fail; kata_sync h2 || s3="fail: $(pull_msg)"; kata_sync h1 || true
            ;;
        ticks)
            setup_ticks_private h1 private.git; r1=$T/hosts/h1/private
            id=$(in_repo h1 "$r1" ticks_create "shared issue"); ticks_sync h1 "$r1" || s1=fail
            setup_ticks_private h2 private.git; r2=$T/hosts/h2/private
            local before after
            before=$(git -C "$r2" config --get merge.tick.driver >/dev/null && echo yes || echo no)
            in_repo h2 "$r2" ticks_list
            after=$(git -C "$r2" config --get merge.tick.driver >/dev/null && echo yes || echo no)
            rec 5 "merge driver on a fresh clone" "registered after clone: $before; after the first tk command: $after (.gitattributes is committed, the driver lives in .git/config)"
            in_repo h1 "$r1" ticks_title "$id" "title from h1"; in_repo h1 "$r1" ticks_label "$id" from-h1
            in_repo h2 "$r2" ticks_title "$id" "title from h2"; in_repo h2 "$r2" ticks_label "$id" from-h2
            ticks_sync h1 "$r1" || s2=fail; ticks_sync h2 "$r2" || s3="fail: $(pull_msg)"; ticks_sync h1 "$r1" || true
            ;;
        beans)
            rec 5 "fields compared" "title on both; priority (h1) and type (h2) stand in for labels (beans has none)"
            beans_two_hosts overwrite
            BEANS_SYNC=append beans_two_hosts append
            return 0 ;;
    esac
    rec 5 "initial sync" "$s1"; rec 5 "h1 sync after edit" "$s2"; rec 5 "h2 sync after edit" "$s3"

    g1=$(state5 h1 "$r1" "$id") || g1=error
    g2=$(state5 h2 "$r2" "$id") || g2=error
    rec 5 "h1 sees" "$g1"; rec 5 "h2 sees" "$g2"
    rec 5 "converged" "$([[ $g1 == "$g2" && $g1 != error ]] && echo yes || echo NO)"
    [[ $g1 == error && $g2 == error ]] && rec 5 "issue after sync" "GONE on both hosts"
    return 0
}

beans_two_hosts() { # beans_two_hosts MODE: test 5 with one journal sync mode (fresh stores each time)
    local mode=$1 id r1=$T/hosts/h1/src/alpha r2=$T/hosts/h2/src/alpha s1=ok s2=ok s3=ok g1 g2 j1 j2
    rm -rf "$T/hosts/h1/.local/share/beans" "$T/hosts/h2/.local/share/beans" "$T/hosts/h1/.config/beans" "$T/hosts/h2/.config/beans"
    rm -rf "$T/remotes/private.git"; git init -q --bare "$T/remotes/private.git"
    setup_beans_private h1 private.git; beans_init_repo h1 "$r1"
    id=$(in_repo h1 "$r1" beans_create "shared issue")
    beans_sync h1 alpha || s1=fail
    setup_beans_private h2 private.git; beans_init_repo h2 "$r2" 2>/dev/null || true; beans_rebuild h2 alpha || s1=fail
    j1=$(wc -l <"$T/hosts/h1/.local/share/beans/alpha/journal.jsonl"); j2=$(in_repo h2 "$r2" beans export-journal | wc -l)
    rec 5 "[$mode] journal: file after h1 sync / h2 export after its rebuild" "$j1 / $j2"
    in_repo h1 "$r1" beans_title "$id" "title from h1"; in_repo h1 "$r1" beans update "$id" --priority 0 >/dev/null
    in_repo h2 "$r2" beans_title "$id" "title from h2"; in_repo h2 "$r2" beans update "$id" --type bug >/dev/null
    beans_sync h1 alpha || s2=fail
    beans_sync h2 alpha || s3="fail: $(pull_msg)"
    beans_sync h1 alpha || true
    g1=$(state5 h1 "$r1" "$id") || g1=error
    g2=$(state5 h2 "$r2" "$id") || g2=error
    rec 5 "[$mode] syncs: initial / h1 / h2" "$s1 / $s2 / $s3"
    rec 5 "[$mode] h1 sees" "$g1"; rec 5 "[$mode] h2 sees" "$g2"
    rec 5 "[$mode] converged" "$([[ $g1 == "$g2" && $g1 != error ]] && echo yes || echo NO)"
    [[ $g1 == error && $g2 == error ]] && rec 5 "[$mode] issue after sync" "GONE on both hosts"
    return 0
}

