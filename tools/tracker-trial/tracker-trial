run_tool() {
    enter_sandbox "$1"
    local n
    for n in ${TESTS//,/ }; do
        echo "tracker-trial: $TOOL test $n" >&2
        # Each test gets fresh host stores; the fixtures (remotes, clones) are rebuilt too.
        stop_daemons
        rm -rf "$T/hosts" "$T/remotes" "$T/scratch"; mkdir -p "$T/hosts" "$T/remotes" "$T/scratch"
        host h1; host h2; fixtures
        case $n in
            1) test1_footprint ;; 2) test2_speed ;; 3) test3_private_store ;; 4) test4_gcrypt ;;
            5) test5_two_hosts ;; 6) test6_claims ;; 7) test7_import ;; 8) test8_deps ;;
            *) die "unknown test $n" ;;
        esac || rec "$n" "harness error" "test exited $?"
    done
    stop_daemons
}

trap 'stop_daemons; [[ -n ${PROXY_PID:-} ]] && kill "$PROXY_PID" 2>/dev/null; rm -rf "$RUNTIME"; true' EXIT
for t in ${TOOLS//,/ }; do
    case $t in kata|ticks|beans) ( run_tool "$t" ) || echo "tracker-trial: $t: harness failed" >&2 ;; *) die "unknown tool $t" ;; esac
done

{
    echo "# tracker-trial results ($(date -u +%Y-%m-%dT%H:%MZ); kata $KATA_VER, ticks $TICKS_VER, beans $("$BIN/beans" --help >/dev/null 2>&1 && pipx list --short 2>/dev/null | awk '/magic-beans/{print $2}'))"
    echo
    echo "| Tool | Test | Check | Result |"
    echo "|---|---|---|---|"
    awk -F'\t' '{gsub(/\|/, "\\|", $4); printf "| %s | %s | %s | %s |\n", $1, $2, $3, $4}' "$RESULTS"
} | tee "$DIR/results.md"
echo "tracker-trial: results in $DIR/results.md and $RESULTS" >&2
