#!/usr/bin/env bash
# tracker-trial — live-test issue trackers against beads' requirements, in a sandbox (chz-vkf, D80 draft).
#
#   tracker-trial [--dir DIR] fetch              download the pinned kata and ticks releases (sha256-checked)
#   tracker-trial [--dir DIR] run [-t TOOLS] [-n TESTS] [-v]
#                                                fetch if needed, then run the tests; results table on stdout
#                                                and in DIR/results.md, raw rows in DIR/results.tsv
#   tracker-trial [--dir DIR] clean              stop leftover daemons and remove DIR
#
#   TOOLS: comma list of kata, ticks, beans (default: all).  TESTS: comma list of 1-8 (default: all).
#   DIR:   default ${XDG_CACHE_HOME:-~/.cache}/tracker-trial (keeps the binaries between runs).
#
# Tests (docs/plans/issue-tracker.md, "Hands-on"):
#   1 footprint: files, hooks, .gitignore and git config changed in a code repo, files under HOME,
#     background processes left running, outbound connections (a logging HTTPS_PROXY; loopback exempt)
#   2 speed: median of 3 runs of create, list, show, sync
#   3 one private store for two projects, outside the worktrees; does code reach the private remote
#   4 the same store through a gcrypt:: remote; grep the remote for plaintext titles and code
#   5 two hosts edit one issue at once (title on both, a label or other field on each), sync, compare
#   6 10 parallel claims on 5 items: claims that succeeded, refused, errors, distinct owners
#   7 import a COPY of this repo's beads (bd export, read-only for the project): what survives
#   8 dependency semantics: ready hides an item blocked by an open item, shows it after the close
#
# Sandbox: every tool runs with HOME, XDG_* (XDG_RUNTIME_DIR: a short tt.* dir in the real one, for
# kata's socket; removed on exit), GIT_CONFIG_GLOBAL, GNUPGHOME (throwaway ed25519/cv25519 key)
# and KATA_HOME under DIR/run/<tool>/, and PATH=DIR/bin:/usr/bin:/bin (never ~/.cargo/bin: chz-if3).
# Nothing outside DIR is written, except that `bd export` reads this repo's .beads (test 7).
# beans (magic-beans) is not downloaded: it comes from $BEANS_BIN or `beans` on PATH (pipx, 0.7.0).
# gpg runs with disable-scdaemon (a sandbox scdaemon would grab the YubiKey); agents are killed at the end.
# Needs: git, git-remote-gcrypt, gpg, jq, sqlite3, python3, curl, sha256sum, bd (test 7).
# Exit 0: all tests ran (the results say how each tool did); 2: usage or setup error.
set -euo pipefail
shopt -s nullglob

KATA_VER=0.23.0
KATA_ASSET=kata_${KATA_VER}_linux_amd64.tar.gz
KATA_SHA=6f869e780e1a2be1bde4c4c98ac520b810beb04498b095674780ffa2aec4669e
TICKS_VER=0.32.0
TICKS_ASSET=tk_${TICKS_VER}_linux_amd64.tar.gz
TICKS_SHA=cecbf832a7dd0ead68a176b327dad6dcad410ab8d711cea6ed198152538a46c5
ALL_TOOLS=kata,ticks,beans
ALL_TESTS=1,2,3,4,5,6,7,8

usage() { sed -n '2,12p' "$0" >&2; exit 2; }
die() { echo "tracker-trial: $*" >&2; exit 2; }
log() { ((VERBOSE)) && echo "  · $*" >&2 || true; }

DIR=${XDG_CACHE_HOME:-$HOME/.cache}/tracker-trial
VERBOSE=0 TOOLS=$ALL_TOOLS TESTS=$ALL_TESTS CMD=""
REPO=$(cd "$(dirname "$0")/../.." && pwd)
REAL_BEANS=${BEANS_BIN:-$(command -v beans || true)}
REAL_BD=$(command -v bd || true)
while (($#)); do
    case $1 in
        --dir) [[ $# -ge 2 ]] || usage; DIR=$2; shift 2 ;;
        -t) [[ $# -ge 2 ]] || usage; TOOLS=$2; shift 2 ;;
        -n) [[ $# -ge 2 ]] || usage; TESTS=$2; shift 2 ;;
        -v) VERBOSE=1; shift ;;
        -h|--help) usage ;;
        fetch|run|clean) CMD=$1; shift ;;
        *) usage ;;
    esac
done
[[ -n $CMD ]] || usage
mkdir -p "$DIR"; DIR=$(cd "$DIR" && pwd)
BIN=$DIR/bin

# ---------------------------------------------------------------- fetch / clean

fetch_one() { # fetch_one REPO VER ASSET SHA BINARY
    local repo=$1 ver=$2 asset=$3 sha=$4 binary=$5 dl=$DIR/dl/$5
    [[ -x $BIN/$binary ]] && return 0
    mkdir -p "$dl" "$BIN"
    curl -fsSL -o "$dl/$asset" "https://github.com/$repo/releases/download/v$ver/$asset"
    echo "$sha  $dl/$asset" | sha256sum -c --quiet - || die "$asset: sha256 mismatch"
    mkdir -p "$dl/x" && tar -xzf "$dl/$asset" -C "$dl/x"
    install -m 755 "$dl/x/$binary" "$BIN/$binary"
    echo "tracker-trial: fetched $binary $ver (sha256 ok)" >&2
}

do_fetch() {
    fetch_one kenn-io/kata "$KATA_VER" "$KATA_ASSET" "$KATA_SHA" kata
    fetch_one pengelbrecht/ticks "$TICKS_VER" "$TICKS_ASSET" "$TICKS_SHA" tk
    [[ -n $REAL_BEANS ]] || die "beans not found (pipx install magic-beans==0.7.0, or set BEANS_BIN)"
    ln -sfn "$REAL_BEANS" "$BIN/beans"
    [[ -n $REAL_BD ]] && ln -sfn "$REAL_BD" "$BIN/bd"
    return 0
}

stop_daemons() { # kata's local daemon, one per KATA_HOME; each sandbox's gpg-agent
    local h
    for h in "$DIR"/run/*/gnupg; do GNUPGHOME=$h gpgconf --kill all >/dev/null 2>&1 || true; done
    for h in "$DIR"/run/*/hosts/*/kata "$DIR"/run/*/scratch/*/kata; do
        [[ -d $h ]] && KATA_HOME=$h HOME=$(dirname "$h") XDG_RUNTIME_DIR=${RUNTIME:-/nonexistent}/$(basename "$(dirname "$(dirname "$(dirname "$h")")")")-$(basename "$(dirname "$h")") \
            "$BIN/kata" daemon stop >/dev/null 2>&1 || true
    done
    pkill -f -- "^$BIN/kata" 2>/dev/null || true
}

do_clean() { stop_daemons; rm -rf "$DIR"; echo "tracker-trial: removed $DIR" >&2; }

case $CMD in
    fetch) do_fetch; exit 0 ;;
    clean) do_clean; exit 0 ;;
esac

# ---------------------------------------------------------------- sandbox

for c in git gpg jq sqlite3 python3 curl sha256sum git-remote-gcrypt; do
    command -v "$c" >/dev/null || die "$c not found"
done
do_fetch

# The only thing outside DIR: per-host runtime dirs (kata's daemon socket), removed on exit.
RUNTIME=$(mktemp -d "${XDG_RUNTIME_DIR:-/tmp}/tt.XXXXXX")
RESULTS=$DIR/results.tsv
: >"$RESULTS"
rec() { printf '%s\t%s\t%s\t%s\n' "$TOOL" "$1" "$2" "$3" >>"$RESULTS"; log "$TOOL [$1] $2: $3"; }

# Per-tool sandbox: shared git config and GPG key; one HOME per host under $T/hosts/<host>.
enter_sandbox() { # enter_sandbox TOOL
    TOOL=$1 T=$DIR/run/$1
    rm -rf "$T"; mkdir -p "$T"/{hosts,remotes,scratch}
    unset BEADS_DIR KATA_SERVER KATA_AUTH_TOKEN MAGIC_BEANS_DIR TICK_OWNER TK_ACTOR NO_PROXY no_proxy
    export PATH=$BIN:/usr/bin:/bin GIT_CONFIG_GLOBAL=$T/gitconfig GNUPGHOME=$T/gnupg
    export GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0 LC_ALL=C.UTF-8 TZ=UTC
    git config --global user.name "Trial User"
    git config --global user.email trial@example.invalid
    git config --global init.defaultBranch main
    git config --global commit.gpgsign false
    git config --global advice.detachedHead false
    git config --global pull.rebase false
    mkdir -p "$GNUPGHOME" && chmod 700 "$GNUPGHOME"
    # Never let a sandbox scdaemon open the card reader (it would hold the YubiKey without pcsc-shared).
    echo disable-scdaemon >"$GNUPGHOME/gpg-agent.conf"
    gpg -q --batch --passphrase '' --quick-gen-key "trial <trial@example.invalid>" ed25519 sign never 2>/dev/null
    KEY=$(gpg --batch --list-keys --with-colons 2>/dev/null | awk -F: '/^fpr/ {print $10; exit}')
    gpg -q --batch --passphrase '' --quick-add-key "$KEY" cv25519 encr never 2>/dev/null
    git config --global user.signingkey "$KEY"
    git config --global gcrypt.participants "$KEY"
    git config --global gcrypt.publish-participants true
    host h1; host h2
    fixtures
}

host() { # host NAME: a fresh HOME with XDG dirs; a short runtime dir (unix socket paths max ~108 bytes)
    local h=$T/hosts/$1
    mkdir -p "$h"/{.config,.local/share,.local/state,.cache,src}
    rm -rf "${RUNTIME:?}/$TOOL-$1"; mkdir -p "$RUNTIME/$TOOL-$1"; chmod 700 "$RUNTIME/$TOOL-$1"
}

# on HOST CMD...: run CMD as that host (its HOME, XDG dirs and KATA_HOME)
on() {
    local h=$T/hosts/$1; shift
    HOME=$h XDG_CONFIG_HOME=$h/.config XDG_DATA_HOME=$h/.local/share XDG_STATE_HOME=$h/.local/state \
        XDG_CACHE_HOME=$h/.cache XDG_RUNTIME_DIR=$RUNTIME/$TOOL-$(basename "$h") KATA_HOME=$h/kata KATA_AUTHOR=${KATA_AUTHOR:-$(basename "$h")} "$@"
}

# Code repos with real history and a marker string, to catch tools that copy code into the store.
fixtures() {
    MARKER="code-marker-$RANDOM$RANDOM"
    local w=$T/scratch/seed p
    for p in alpha beta; do
        git init -q --bare "$T/remotes/$p.git"
        rm -rf "$w"; git init -q "$w"
        printf 'print("%s %s")\n' "$MARKER" "$p" >"$w/main.py"
        git -C "$w" add -A && git -C "$w" commit -qm "initial $p"
        echo "# $p" >"$w/README.md"
        git -C "$w" add -A && git -C "$w" commit -qm "readme"
        git -C "$w" push -q "file://$T/remotes/$p.git" main
        # The origin is a fake hosted URL: kata and tk derive the project from it and reject file://.
        local hh
        for hh in h1 h2; do
            on $hh git clone -q "file://$T/remotes/$p.git" "$T/hosts/$hh/src/$p"
            git -C "$T/hosts/$hh/src/$p" remote set-url origin "https://example.invalid/trial/$p.git"
        done
    done
    git init -q --bare "$T/remotes/private.git"
    git init -q --bare "$T/remotes/private-gc.git"
    rm -rf "$w"
}

ms_now() { local t=${EPOCHREALTIME/./}; echo $((t / 1000)); }
median3() { printf '%s\n' "$@" | sort -n | sed -n 2p; }

# A logging proxy: every CONNECT/GET line a client sends lands in $T/proxy.log.
start_proxy() {
    : >"$T/proxy.log"
    python3 -I - "$T/proxy.log" "$T/proxy.port" <<'PY' &
import socket, sys
log, portfile = sys.argv[1], sys.argv[2]
s = socket.socket(); s.bind(("127.0.0.1", 0)); s.listen(16)
open(portfile, "w").write(str(s.getsockname()[1]))
while True:
    c, _ = s.accept()
    c.settimeout(2)
    try:
        line = c.recv(4096).split(b"\r\n", 1)[0].decode(errors="replace")
        open(log, "a").write(line + "\n")
    except OSError:
        pass
    c.close()
PY
    PROXY_PID=$!
    local i
    for i in {1..50}; do [[ -s $T/proxy.port ]] && break; sleep 0.1; done
    HTTPS_PROXY=http://127.0.0.1:$(<"$T/proxy.port")
    export HTTPS_PROXY HTTP_PROXY=$HTTPS_PROXY
}
stop_proxy() { kill "$PROXY_PID" 2>/dev/null || true; wait "$PROXY_PID" 2>/dev/null || true; unset HTTPS_PROXY HTTP_PROXY; }

# Snapshot of what a tool can change in a repo and a HOME.
snapshot() { # snapshot REPO HOME OUT: one "section: line" per fact, so a diff keeps the section
    {
        git -C "$1" status --porcelain --ignored --untracked-files=all | sed 's/^/status: /'
        find "$1/.git/hooks" -type f ! -name '*.sample' -printf 'hook: %P\n'
        git -C "$1" config --local --list | sed 's/^/git config: /'
        sed 's/^/info\/attributes: /' "$1/.git/info/attributes" 2>/dev/null || true
        find "$2" -path "$2/src" -prune -o -type f -printf 'home: %P\n'
    } | sort >"$3"
}

# git_sync HOST DIR: commit everything, merge the remote's main if it exists, push. 1 = conflict/failure
# (the merge is aborted; stderr kept in scratch/pull.err).
git_sync() {
    local d=$2
    git -C "$d" add -A && { git -C "$d" commit -qm "sync $1" >/dev/null || true; }
    if on "$1" git -C "$d" ls-remote --exit-code origin main >/dev/null 2>&1; then
        if ! on "$1" git -C "$d" pull --no-edit origin main >"$T/scratch/pull.err" 2>&1; then
            git -C "$d" merge --abort 2>/dev/null || true
            return 1
        fi
    fi
    on "$1" git -C "$d" push -q origin HEAD:main 2>>"$T/scratch/pull.err" || return 1
}

# clone_or_init HOST URL DIR: clone main, or start an empty repo with that origin.
clone_or_init() {
    rm -rf "$3"
    on "$1" git clone -q -b main "$2" "$3" >/dev/null 2>&1 && return 0
    rm -rf "$3"; mkdir -p "$3"; git -C "$3" init -q; git -C "$3" remote add origin "$2"
}

# ================================================================ adapters
# Each tool implements: <tool>_init_repo HOST REPO (in-repo/default setup), <tool>_create TITLE -> id,
# _list, _show ID, _title ID TITLE, _label ID LABEL (exit 3 = unsupported), _block BLOCKER ID,
# _ready -> ids, _close ID, _claim ID ACTOR, _get ID -> {title, labels, extra}, plus the store tests.
# All run inside the cwd of the project they act on, as a host (via `on`).

# ---------------------------------------------------------------- kata
kata_init_repo() { (cd "$2" && on "$1" kata init --project "$(basename "$2")" --agent >/dev/null); }
kata_create() { kata create "$1" --body "trial" --force-new --json | jq -r '.issue.short_id'; }
kata_list() { kata list --status all --limit 0 --json >/dev/null; }
kata_show() { kata show "$1" --json >/dev/null; }
kata_title() { kata edit "$1" --title "$2" --agent >/dev/null; }
kata_label() { kata label add "$1" "$2" --agent >/dev/null; }
kata_block() { kata edit "$2" --blocked-by "$1" --agent >/dev/null; }
kata_ready() { kata ready --json | jq -r '.issues[]?.short_id'; }
kata_close() { kata close "$1" --done -m "Closed by tracker-trial: the dependency test is done." --test true --agent >/dev/null; }
kata_claim() { kata claim "$1" --as "$2" --if-unowned --agent >/dev/null 2>&1; }
kata_owner() { kata show "$1" --json | jq -r '.issue.owner // ""'; }
kata_get() { kata show "$1" --json | jq -c '{title: .issue.title, labels: ([.issue.labels[]?] | sort), extra: .issue.priority}'; }
# shellcheck disable=SC2034 # read through ${!edges_var} in test8_deps
KATA_EDGES="blocks, blocked-by, parent (no gating), related; plus duplicate-of"

# kata's store is the daemon's SQLite under KATA_HOME. Its own multi-host story is a shared daemon or
# federation, not git; the git option tested here: stop the daemon, snapshot kata.db into the private
# repo, merge, copy back.
kata_sync() { # kata_sync HOST
    local h=$T/hosts/$1 priv=$T/hosts/$1/private
    on "$1" kata daemon stop >/dev/null 2>&1 || true
    # .backup, not cp: right after `daemon stop` the WAL is not always checkpointed yet, and a plain
    # copy of kata.db then misses the latest writes (seen in this harness).
    [[ -f $h/kata/kata.db ]] && sqlite3 "$h/kata/kata.db" ".backup '$priv/kata.db'"
    git_sync "$1" "$priv" || return 1
    mkdir -p "$h/kata"; cp "$priv/kata.db" "$h/kata/kata.db"
    rm -f "$h/kata/kata.db-wal" "$h/kata/kata.db-shm"
}

# ---------------------------------------------------------------- ticks
tk_init_here() { tk init >/dev/null 2>&1; }
ticks_init_repo() { (cd "$2" && on "$1" tk init >/dev/null 2>&1); }
ticks_create() { tk create "$1" -d trial --json | jq -r '.id'; }
ticks_list() { tk list --all --status all --json >/dev/null; }
ticks_show() { tk show "$1" --json >/dev/null; }
ticks_title() { tk update "$1" --title "$2" >/dev/null; }
ticks_label() { tk label add "$1" "$2" >/dev/null; }
ticks_block() { tk block "$2" "$1" >/dev/null; }
ticks_ready() { tk ready --all --limit 100 --json | jq -r '.ticks[]?.id'; }
ticks_close() { tk close "$1" >/dev/null 2>&1 || tk update "$1" --status closed >/dev/null; }
ticks_claim() { tk update "$1" --status in_progress --owner "$2" >/dev/null 2>&1; }
ticks_owner() { tk show "$1" --json | jq -r '.owner // ""'; }
ticks_get() { tk show "$1" --json | jq -c '{title, labels: ((.labels // []) | sort), extra: .priority}'; }
# shellcheck disable=SC2034
TICKS_EDGES="blocked_by, parent, discovered_from, after (soft order); no related"

# ticks' store is .tick/ at the git root: one store = one git repo. Sync = commit + pull (merge
# driver) + push.
ticks_sync() { git_sync "$1" "$2"; } # ticks_sync HOST REPO

# ---------------------------------------------------------------- beans
beans_init_repo() { (cd "$2" && on "$1" beans init --name "$(basename "$2")" >/dev/null); }
beans_create() { beans --json create "$1" --body trial | jq -r '.id'; }
beans_list() { beans --json list >/dev/null; }
beans_show() { beans --json show "$1" >/dev/null; }
beans_title() { beans update "$1" --title "$2" >/dev/null; }
beans_label() { return 3; } # no labels in schema v2
beans_block() { beans dep add "$1" "$2" >/dev/null; } # FROM blocks TO
beans_ready() { beans --json ready | jq -r '.[]?.id'; }
beans_close() { beans close "$1" >/dev/null; }
beans_claim() { beans claim "$1" --actor "$2" >/dev/null 2>&1; }
beans_owner() { beans --json show "$1" | jq -r '.assignee // ""'; }
beans_get() { beans --json show "$1" | jq -c '{title, labels: [], extra: .priority}'; }
# shellcheck disable=SC2034
BEANS_EDGES="blocks (dep_type column, one edge per pair), parent_id"

# beans' store: the registry maps a project to a directory; the private repo is checked out at
# $XDG_DATA_HOME/beans, its .gitignore keeps only journal.jsonl. Sync = export-journal, commit,
# pull, push, rebuild the db from the merged journal.
# BEANS_SYNC=overwrite: the documented flow (export-journal > journal.jsonl). BEANS_SYNC=append: the
# workaround: rebuild empties the journal table, so each export holds only the entries since the last
# rebuild; append them, union-merge the file in git (.gitattributes), replay it.
beans_sync() { # beans_sync HOST PROJECT...
    local h=$1 store=$T/hosts/$1/.local/share/beans p; shift
    for p in "$@"; do
        if [[ ${BEANS_SYNC:-overwrite} == append ]]; then
            printf 'journal.jsonl merge=union\n' >"$store/$p/.gitattributes"
            (cd "$T/hosts/$h/src/$p" && on "$h" beans export-journal >>"$store/$p/journal.jsonl")
        else
            (cd "$T/hosts/$h/src/$p" && on "$h" beans export-journal >"$store/$p/journal.jsonl")
        fi
    done
    git_sync "$h" "$store" || return 1
    for p in "$@"; do beans_rebuild "$h" "$p" || return 1; done
}
beans_rebuild() { # beans_rebuild HOST PROJECT: replace the db with a replay of journal.jsonl
    local db=$T/hosts/$1/.local/share/beans/$2/beans.db
    [[ -s ${db%/*}/journal.jsonl ]] || return 0
    rm -f "$db" "$db-wal" "$db-shm"
    (cd "$T/hosts/$1/src/$2" && on "$1" beans rebuild "${db%/*}/journal.jsonl" >/dev/null 2>"$T/scratch/rebuild.err")
}

# ================================================================ tests

adapter() { local op=$1; shift; "${TOOL}_$op" "$@"; }
in_repo() { local h=$1 r=$2; shift 2; (cd "$r" && on "$h" "$@"); }

test1_footprint() {
    local r=$T/hosts/h1/src/alpha before=$T/scratch/fp.before after=$T/scratch/fp.after id procs net
    snapshot "$r" "$T/hosts/h1" "$before"
    start_proxy
    adapter init_repo h1 "$r"
    id=$(in_repo h1 "$r" adapter_create "footprint one")
    in_repo h1 "$r" adapter_create "footprint two" >/dev/null
    in_repo h1 "$r" adapter_list
    in_repo h1 "$r" adapter_show "$id"
    sleep 1
    stop_proxy
    net=$(sort -u "$T/proxy.log" | paste -sd';')
    rec 1 "outbound connections (init, create, list, show)" "${net:-none}"
    if [[ $TOOL == ticks ]]; then # tk's periodic check is cached in ~/.config/tk; `tk version` always checks
        start_proxy; in_repo h1 "$r" tk list --all >/dev/null 2>&1 || true; sleep 1; stop_proxy
        net=$(sort -u "$T/proxy.log" | paste -sd';')
        rec 1 "outbound connections (a second command, cache fresh)" "${net:-none}"
    fi
    snapshot "$r" "$T/hosts/h1" "$after"
    rec 1 "repo changes" "$(comm -13 "$before" "$after" | grep -v '^home: ' | paste -sd';' | head -c 600)"
    rec 1 "files under HOME" "$(comm -13 "$before" "$after" | sed -n 's/^home: //p' | awk -F/ '{print (NF > 3 ? $1 "/" $2 "/" $3 "/" : $0)}' | sort | uniq -c | awk '{printf "%s%s (%d)", sep, $2, $1; sep=", "}')"
    procs=$(pgrep -af -- "^$BIN/" | cut -d' ' -f2- | sed "s|^$BIN/||" | sort -u | paste -sd';' || true)
    rec 1 "processes left running" "${procs:-none}"
}

adapter_create() { "${TOOL}_create" "$@"; }
adapter_list() { "${TOOL}_list" "$@"; }
adapter_show() { "${TOOL}_show" "$@"; }

time3() { # time3 LABEL CMD...: median of three runs, in ms
    local a b c t0 label=$1; shift
    t0=$(ms_now); "$@" >/dev/null; a=$(($(ms_now) - t0))
    t0=$(ms_now); "$@" >/dev/null; b=$(($(ms_now) - t0))
    t0=$(ms_now); "$@" >/dev/null; c=$(($(ms_now) - t0))
    rec 2 "$label" "$(median3 $a $b $c) ms (runs $a/$b/$c)"
}

test2_speed() {
    local r=$T/hosts/h1/src/beta id
    adapter init_repo h1 "$r"
    id=$(in_repo h1 "$r" "${TOOL}_create" "warm-up")
    [[ $TOOL == kata ]] && rec 2 "note" "daemon already running (auto-started by the warm-up)"
    for i in 1 2 3 4 5; do in_repo h1 "$r" "${TOOL}_create" "filler $i" >/dev/null; done
    time3 create in_repo h1 "$r" "${TOOL}_create" "timed"
    time3 "list (all)" in_repo h1 "$r" "${TOOL}_list"
    time3 show in_repo h1 "$r" "${TOOL}_show" "$id"
    case $TOOL in
        kata) setup_private_plain h1; time3 "sync (stop daemon, commit db, pull, push)" kata_sync h1 ;;
        ticks) setup_ticks_private h1 private.git; time3 "sync (commit, pull, push)" ticks_sync h1 "$T/hosts/h1/private" ;;
        beans) setup_beans_private h1 private.git; beans_init_repo h1 "$r" 2>/dev/null || true
               time3 "sync (export-journal, commit, pull, push, rebuild)" beans_sync h1 beta ;;
    esac
}

setup_private_plain() { # clone private.git as HOST/private
    [[ -d $T/hosts/$1/private/.git ]] || clone_or_init "$1" "file://$T/remotes/private.git" "$T/hosts/$1/private"
}

# ticks: one private repo holds the .tick store (projects separated by label).
setup_ticks_private() { # HOST REMOTE [gcrypt]
    local p=$T/hosts/$1/private url="file://$T/remotes/$2"
    [[ ${3:-} == gcrypt ]] && url="gcrypt::$url"
    clone_or_init "$1" "$url" "$p"
    if [[ ! -d $p/.tick ]]; then
        (cd "$p" && on "$1" tk init >/dev/null 2>&1)
        git_sync "$1" "$p"
    fi
}

# beans: the private repo checked out at XDG_DATA_HOME/beans.
setup_beans_private() { # HOST REMOTE [gcrypt]
    local url="file://$T/remotes/$2"
    [[ ${3:-} == gcrypt ]] && url="gcrypt::$url"
