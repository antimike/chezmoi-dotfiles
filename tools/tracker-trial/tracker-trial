            ticks_sync h1 "$T/hosts/h1/private" || true
            n=$(in_repo h1 "$T/hosts/h1/private" tk list --all --status all --json | jq '[.ticks[] | select(.title | startswith("issue in"))] | length')
            rec 3 "one store, two projects" "only as one .tick store in a separate private repo, projects as labels ($n of 2; no TICK_DIR in 0.32.0: the store is <git root>/.tick, so tk runs from that checkout, not the project)"
            ;;
