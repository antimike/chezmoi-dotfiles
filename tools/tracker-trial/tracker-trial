test7_import() {
    local w=$T/scratch/import out note_probe
    [[ -n $REAL_BD ]] || { rec 7 "import" "skipped: bd not found"; return; }
    if [[ ! -s $DIR/chz.jsonl ]]; then # read-only for the project: export and ready
        (cd "$REPO" && env PATH="$PATH" bd export --include-memories --output "$DIR/chz.jsonl" >/dev/null)
        (cd "$REPO" && env PATH="$PATH" bd ready --json -n 0 2>/dev/null | jq length >"$DIR/bd-ready.count")
    fi
    rec 7 "beads export (source)" "$(beads_counts | jq -c ". + {ready: $(<"$DIR/bd-ready.count")}")"
    mkdir -p "$w"
    case $TOOL in
        kata)
            # kata imports from a live bd store in the cwd: restore the export into a scratch bd first.
            (cd "$w" && git init -q && on h1 bd init --prefix chz >/dev/null 2>&1 && on h1 bd config set no-git-ops true >/dev/null 2>&1 \
                && on h1 bd import "$DIR/chz.jsonl" >/dev/null 2>&1)
            (cd "$w" && on h1 kata init --project chz --agent >/dev/null && on h1 kata import --source-format beads >"$T/scratch/import.out" 2>&1) || true
            rec 7 "importer says" "$(tr '\n' ' ' <"$T/scratch/import.out" | head -c 200)"
            (cd "$w" && on h1 kata export --allow-running-daemon --output "$T/scratch/kata.jsonl" >/dev/null 2>&1)
            out=$(jq -s '{
                issues: [.[] | select(.kind == "issue")] | length,
                status: ([.[] | select(.kind == "issue") | .data.status] | group_by(.) | map({(.[0]): length}) | add),
                status_labels: ([.[] | select(.kind == "issue_label") | .data.label | select(startswith("beads-status:"))] | group_by(.) | map({(.[0]): length}) | add),
                labels: [.[] | select(.kind == "issue_label") | .data.label | select(test("^(beads-|source:)") | not)] | length,
                edges: ([.[] | select(.kind == "link") | .data.type] | group_by(.) | map({(.[0]): length}) | add)}' "$T/scratch/kata.jsonl")
            out=$(jq --argjson r "$(cd "$w" && on h1 kata ready --limit 0 --json | jq '.issues | length')" '. + {ready: $r}' <<<"$out")
            note_probe=$(jq -r 'select(._type == "issue" and (.notes // "") != "") | .notes[0:40]' "$DIR/chz.jsonl" | head -1)
            out=$(jq --arg n "$(jq -s --arg p "$note_probe" '[.[] | select(.kind == "issue") | .data.body // "" | select(contains($p))] | length' "$T/scratch/kata.jsonl")" '. + {notes_probe_found: ($n | tonumber)}' <<<"$out")
            ;;
        ticks)
            (cd "$w" && git init -q && git remote add origin "file://$T/remotes/import.git" && on h1 tk init >/dev/null 2>&1 \
                && on h1 tk import "$DIR/chz.jsonl" >"$T/scratch/import.out" 2>&1) || true
            rec 7 "importer says (export with memories)" "$(head -1 "$T/scratch/import.out" | head -c 200)"
            # Again from the issues only: the memory record is what it chokes on.
            rm -rf "$w"; mkdir -p "$w"; jq -c 'select(._type == "issue")' "$DIR/chz.jsonl" >"$T/scratch/issues-only.jsonl"
            (cd "$w" && git init -q && git remote add origin "file://$T/remotes/import.git" && on h1 tk init >/dev/null 2>&1 \
                && on h1 tk import "$T/scratch/issues-only.jsonl" >"$T/scratch/import.out" 2>&1) || true
            rec 7 "importer says (issues only)" "$(tr '\n' ' ' <"$T/scratch/import.out" | head -c 200)"
            out=$(cat "$w"/.tick/issues/*.json 2>/dev/null | jq -s '{
                issues: length,
                status: (map(.status) | group_by(.) | map({(.[0]): length}) | add),
                labels: (map(.labels // [] | length) | add),
                notes: (map(select((.notes // "") != "")) | length),
                edges: {blocked_by: (map(.blocked_by // [] | length) | add), parent: (map(select((.parent // "") != "")) | length),
                        discovered_from: (map(select((.discovered_from // "") != "")) | length)},
                deferred_until: (map(select(.defer_until != null)) | length)}')
            out=$(jq --argjson r "$(cd "$w" && on h1 tk ready --all --limit 1000 --json | jq '.ticks | length')" '. + {ready: $r}' <<<"$out")
            ;;
        beans)
            # No importer: convert the export to a beans journal (new hex ids, old id in ref_id,
            # notes appended to the body; labels and other edge types have nowhere to go).
            beads_to_journal "$DIR/chz.jsonl" >"$w/journal.jsonl"
            mkdir -p "$w/repo" && git -C "$w/repo" init -q
            (cd "$w/repo" && on h1 beans init --name chzimport >/dev/null && \
                rm -f "$T/hosts/h1/.local/share/beans/chzimport/beans.db" && \
                on h1 beans rebuild "$w/journal.jsonl" >"$T/scratch/import.out" 2>&1) || true
            rec 7 "importer says" "none upstream; jq converter: $(tr '\n' ' ' <"$T/scratch/import.out" | head -c 160)"
            local db=$T/hosts/h1/.local/share/beans/chzimport/beans.db
            out=$(jq -n --argjson n "$(sqlite3 "$db" 'select count(*) from beans' 2>/dev/null || echo 0)" \
                --argjson st "$(sqlite3 -json "$db" 'select status, count(*) n from beans group by status' 2>/dev/null || echo '[]')" \
                --argjson dp "$(sqlite3 -json "$db" 'select dep_type, count(*) n from deps group by dep_type' 2>/dev/null || echo '[]')" \
                --argjson pa "$(sqlite3 "$db" 'select count(*) from beans where parent_id is not null' 2>/dev/null || echo 0)" \
                '{issues: $n, status: ($st | map({(.status): .n}) | add), labels: 0, notes: "appended to body by the converter",
                  edges: (($dp | map({(.dep_type): .n}) | add // {}) + {parent_id: $pa})}')
            out=$(jq --argjson r "$(cd "$w/repo" && on h1 beans --json ready | jq length)" '. + {ready: $r}' <<<"$out")
            ;;
    esac
    rec 7 "after import" "$(jq -c . <<<"$out")"
}

# bd export JSONL -> beans journal. Statuses outside open/in_progress/closed become open.
beads_to_journal() {
    jq -cs '
      [.[] | select(._type == "issue")] as $i
      | ($i | to_entries | map({key: .value.id, value: ("task-" + ("00000000" + (.key + 1 | tostring))[-8:])}) | from_entries) as $id
      | ($i | map(select(.dependencies // [] | any(.type == "parent-child"))) | map({key: .id, value: $id[(.dependencies[] | select(.type == "parent-child") | .depends_on_id)]}) | from_entries) as $parent
      | ($i[] | {action: "create", bean_id: $id[.id], created_at: .created_at, snapshot: {
            id: $id[.id], title, type: (if .issue_type == "epic" or .issue_type == "bug" then .issue_type else "task" end),
            status: (if .status == "in_progress" or .status == "closed" then .status else "open" end),
            priority: (.priority // 2), body: ((.description // "") + (if (.notes // "") != "" then "\n\nNOTES\n" + .notes else "" end)),
            parent_id: $parent[.id], assignee: null, created_by: null, ref_id: .id, created_at: .created_at,
            closed_at: .closed_at, close_reason: .close_reason}}),
        ($i[] | . as $x | .dependencies // [] | .[] | select(.type == "blocks") | select($id[.depends_on_id] != null)
            | {action: "dep_add", bean_id: $id[$x.id], created_at: $x.created_at,
               snapshot: {from_id: $id[.depends_on_id], to_id: $id[$x.id], dep_type: "blocks"}})' "$1"
}

